# CQ-09: Requested and promised delivery dates

PREFIX sd:   <https://abhigya.ai/ontology/sales-distribution#>
PREFIX sdi:  <https://abhigya.ai/ontology/sales-distribution/data#>
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl:  <http://www.w3.org/2002/07/owl#>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>

SELECT ?orderIdentifier ?requestedDate ?promisedDate
WHERE {
  ?order a sd:SalesDistributionOntologySalesOrder ;
         sd:SalesDistributionOntologyidentifier ?orderIdentifier ;
         sd:SalesDistributionOntologyhasDeliveryPromise ?promise .
  OPTIONAL { ?promise sd:SalesDistributionOntologyrequestedDeliveryDate ?requestedDate }
  OPTIONAL { ?promise sd:SalesDistributionOntologypromisedDeliveryDate ?promisedDate }
}
