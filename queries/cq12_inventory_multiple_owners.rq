# CQ-12: Inventory records with multiple explicit owners

PREFIX sd:   <https://abhigya.ai/ontology/sales-distribution#>
PREFIX sdi:  <https://abhigya.ai/ontology/sales-distribution/data#>
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl:  <http://www.w3.org/2002/07/owl#>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>

SELECT ?inventory (COUNT(DISTINCT ?owner) AS ?ownerCount)
WHERE {
  ?inventory a sd:SalesDistributionOntologyInventory ;
             sd:SalesDistributionOntologyownedBy ?owner .
}
GROUP BY ?inventory
HAVING (COUNT(DISTINCT ?owner) > 1)
