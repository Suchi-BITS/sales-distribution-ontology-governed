###  https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntologyInvoice
sd:SalesDistributionOntologyInvoice rdf:type owl:Class ;
                                    rdfs:subClassOf [ rdf:type owl:Restriction ;
                                                      owl:onProperty sd:SalesDistributionOntologyforCustomer ;
                                                      owl:someValuesFrom sd:SalesDistributionOntologyCustomer
                                                    ] ,
                                                    [ rdf:type owl:Restriction ;
                                                      owl:onProperty sd:SalesDistributionOntologyissuedBy ;
                                                      owl:someValuesFrom sd:SalesDistributionOntologyBusinessOrganization
                                                    ] ,
                                                    [ rdf:type owl:Restriction ;
                                                      owl:onProperty sd:SalesDistributionOntologyhasInvoiceLine ;
                                                      owl:minCardinality "1"^^xsd:nonNegativeInteger
                                                    ] ,
                                                    [ rdf:type owl:Restriction ;
                                                      owl:onProperty sd:SalesDistributionOntologyinvoiceDate ;
                                                      owl:someValuesFrom xsd:date
                                                    ] ;
                                    owl:hasKey ( sd:SalesDistributionOntologyidentifier
                                               ) ;
                                    rdfs:comment "A commercial document requesting payment for goods delivered."@en ;
                                    rdfs:isDefinedBy <https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntology> ;
                                    rdfs:label "Invoice"@en ;
                                    sd:SalesDistributionOntologyerpMapping "SAP SD: Billing document (VBRK / VBRP)" ;
                                    sd:SalesDistributionOntologyinModule sd:SalesDistributionOntologyInvoicingModule .


###  https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntologyInvoiceLine
sd:SalesDistributionOntologyInvoiceLine rdf:type owl:Class ;
                                        rdfs:subClassOf [ rdf:type owl:Restriction ;
                                                          owl:onProperty sd:SalesDistributionOntologyinvoicesOrderLine ;
                                                          owl:someValuesFrom sd:SalesDistributionOntologySalesOrderLine
                                                        ] ,
                                                        [ rdf:type owl:Restriction ;
                                                          owl:onProperty sd:SalesDistributionOntologybelongsToInvoice ;
                                                          owl:cardinality "1"^^xsd:nonNegativeInteger
                                                        ] ;
                                        rdfs:comment "A line of an invoice specifying product, quantity and amounts."@en ;
