###  https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntologyCancelledOrder
sd:SalesDistributionOntologyCancelledOrder rdf:type owl:Class ;
                                           owl:equivalentClass [ owl:intersectionOf ( sd:SalesDistributionOntologySalesOrder
                                                                                      [ rdf:type owl:Restriction ;
                                                                                        owl:onProperty sd:SalesDistributionOntologyhasOrderStatus ;
                                                                                        owl:hasValue sdi:Status_Cancelled
                                                                                      ]
                                                                                    ) ;
                                                                 rdf:type owl:Class
                                                               ] ;
                                           rdfs:comment "A sales order whose status is Cancelled."@en ;
                                           rdfs:isDefinedBy <https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntology> ;
                                           rdfs:label "Cancelled Order"@en .


###  https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntologyChannel
sd:SalesDistributionOntologyChannel rdf:type owl:Class ;
                                    rdfs:comment "A route to market through which products are sold, for example general trade, modern trade or e-commerce."@en ;
                                    rdfs:isDefinedBy <https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntology> ;
                                    rdfs:label "Channel"@en ;
                                    sd:SalesDistributionOntologyerpMapping "SAP SD: Distribution Channel (VTWEG)" ;
                                    sd:SalesDistributionOntologyinModule sd:SalesDistributionOntologyRouteToMarketModule .


###  https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntologyChannelAgreement
sd:SalesDistributionOntologyChannelAgreement rdf:type owl:Class ;
                                             rdfs:subClassOf sd:SalesDistributionOntologyPartnerRelationship ,
                                                             [ rdf:type owl:Restriction ;
                                                               owl:onProperty sd:SalesDistributionOntologyagreementWith ;
                                                               owl:someValuesFrom sd:SalesDistributionOntologyChannelPartner
                                                             ] ;
                                             rdfs:comment "A contract setting commercial terms, margins, targets and obligations for a channel partner."@en ;
                                             rdfs:isDefinedBy <https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntology> ;
                                             rdfs:label "Channel Agreement"@en ;
                                             sd:SalesDistributionOntologyinModule sd:SalesDistributionOntologyDistributorManagementModule .


###  https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntologyChannelPartner
sd:SalesDistributionOntologyChannelPartner rdf:type owl:Class ;
                                           rdfs:subClassOf sd:SalesDistributionOntologyBusinessOrganization ,
                                                           sd:SalesDistributionOntologyCustomer ;
                                           owl:hasKey ( sd:SalesDistributionOntologyidentifier
                                                      ) ;
                                           rdfs:comment "An external organization (distributor, wholesaler, retailer, institution) that buys, stocks or resells the brand owner's products."@en ;
                                           rdfs:isDefinedBy <https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntology> ;
                                           rdfs:label "Channel Partner"@en ;
                                           sd:SalesDistributionOntologyinModule sd:SalesDistributionOntologyDistributorManagementModule .


###  https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntologyChannelType
sd:SalesDistributionOntologyChannelType rdf:type owl:Class ;
                                        rdfs:comment "A classification value describing the nature of a sales channel."@en ;
                                        rdfs:isDefinedBy <https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntology> ;
                                        rdfs:label "Channel Type"@en ;
                                        sd:SalesDistributionOntologyinModule sd:SalesDistributionOntologyRouteToMarketModule .


###  https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntologyClaim
sd:SalesDistributionOntologyClaim rdf:type owl:Class ;
                                  rdfs:subClassOf [ rdf:type owl:Restriction ;
                                                    owl:onProperty sd:SalesDistributionOntologyclaimedBy ;
                                                    owl:someValuesFrom sd:SalesDistributionOntologyChannelPartner
                                                  ] ;
                                  rdfs:comment "A monetary claim raised by a channel partner or the brand owner (scheme, rebate, damage or expiry) that must be validated and settled."@en ;
                                  rdfs:isDefinedBy <https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntology> ;
                                  rdfs:label "Claim"@en .


###  https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntologyCollection
sd:SalesDistributionOntologyCollection rdf:type owl:Class ;
                                       rdfs:comment "A collection activity or batch of collected payments from a customer."@en ;
                                       rdfs:isDefinedBy <https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntology> ;
                                       rdfs:label "Collection"@en ;
                                       sd:SalesDistributionOntologyinModule sd:SalesDistributionOntologyCollectionsModule .


