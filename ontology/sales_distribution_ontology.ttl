                                        rdfs:isDefinedBy <https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntology> ;
                                        rdfs:label "Scheme Claim"@en ;
                                        sd:SalesDistributionOntologyinModule sd:SalesDistributionOntologyTradePromotionModule .


###  https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntologySecondarySale
sd:SalesDistributionOntologySecondarySale rdf:type owl:Class ;
                                          rdfs:comment "Sale from distributor/stockist to retailer or downstream channel partner."@en ;
                                          rdfs:isDefinedBy <https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntology> ;
                                          rdfs:label "Secondary Sale"@en ;
                                          skos:altLabel "Secondary Sales"@en ;
                                          sd:SalesDistributionOntologyinModule sd:SalesDistributionOntologySecondarySalesModule .


###  https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntologySecondarySalesModule
sd:SalesDistributionOntologySecondarySalesModule rdf:type owl:Class ;
                                                 rdfs:subClassOf sd:SalesDistributionOntologySalesDistributionManagement ;
                                                 rdfs:comment "Capability for capturing and tracking sales from distributors to retailers."@en ;
                                                 rdfs:isDefinedBy <https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntology> ;
                                                 rdfs:label "Secondary Sales Module"@en .


###  https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntologySecondarySalesOrder
sd:SalesDistributionOntologySecondarySalesOrder rdf:type owl:Class ;
                                                rdfs:subClassOf sd:SalesDistributionOntologySalesOrder ,
                                                                sd:SalesDistributionOntologySecondarySalesTransaction ;
                                                rdfs:comment "A sales order placed by a downstream partner (typically a retailer) on a distributor."@en ;
                                                rdfs:isDefinedBy <https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntology> ;
                                                rdfs:label "Secondary Sales Order"@en ;
                                                sd:SalesDistributionOntologyinModule sd:SalesDistributionOntologyOrderManagementModule .


###  https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntologySecondarySalesTransaction
sd:SalesDistributionOntologySecondarySalesTransaction rdf:type owl:Class ;
                                                      rdfs:subClassOf sd:SalesDistributionOntologySecondarySale ,
                                                                      [ rdf:type owl:Restriction ;
                                                                        owl:onProperty sd:SalesDistributionOntologyplacedBy ;
                                                                        owl:someValuesFrom sd:SalesDistributionOntologyRetailer
                                                                      ] ;
                                                      rdfs:comment "A secondary sale event between a distributor and a downstream partner."@en ;
                                                      rdfs:isDefinedBy <https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntology> ;
                                                      rdfs:label "Secondary Sales Transaction"@en ;
                                                      sd:SalesDistributionOntologyinModule sd:SalesDistributionOntologySecondarySalesModule .


