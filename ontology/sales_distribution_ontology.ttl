                                               rdfs:isDefinedBy <https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntology> ;
                                               rdfs:label "Available Inventory"@en ;
                                               sd:SalesDistributionOntologyinModule sd:SalesDistributionOntologyInventoryManagementModule .


###  https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntologyAvailableToPromise
sd:SalesDistributionOntologyAvailableToPromise rdf:type owl:Class ;
                                               rdfs:comment "The quantity and date that can be promised to a customer based on current and planned supply."@en ;
                                               rdfs:isDefinedBy <https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntology> ;
                                               rdfs:label "Available To Promise"@en ;
                                               skos:altLabel "ATP"@en ;
                                               sd:SalesDistributionOntologyinModule sd:SalesDistributionOntologyOrderManagementModule .


###  https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntologyBackorder
sd:SalesDistributionOntologyBackorder rdf:type owl:Class ;
                                      rdfs:subClassOf sd:SalesDistributionOntologyOrderException ;
                                      rdfs:comment "An unfulfilled quantity of an order that remains open until stock is available."@en ;
                                      rdfs:isDefinedBy <https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntology> ;
                                      rdfs:label "Backorder"@en ;
                                      sd:SalesDistributionOntologyinModule sd:SalesDistributionOntologyOrderManagementModule .


###  https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntologyBackorderedOrder
sd:SalesDistributionOntologyBackorderedOrder rdf:type owl:Class ;
                                             owl:equivalentClass [ owl:intersectionOf ( sd:SalesDistributionOntologySalesOrder
                                                                                        [ rdf:type owl:Restriction ;
                                                                                          owl:onProperty sd:SalesDistributionOntologyhasException ;
                                                                                          owl:someValuesFrom sd:SalesDistributionOntologyBackorder
                                                                                        ]
                                                                                      ) ;
                                                                   rdf:type owl:Class
                                                                 ] ;
                                             rdfs:comment "A sales order that has at least one backorder exception."@en ;
                                             rdfs:isDefinedBy <https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntology> ;
                                             rdfs:label "Backordered Order"@en .


###  https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntologyBasePrice
sd:SalesDistributionOntologyBasePrice rdf:type owl:Class ;
                                      rdfs:subClassOf sd:SalesDistributionOntologyPrice ;
                                      rdfs:comment "The standard reference price before customer-specific conditions."@en ;
                                      rdfs:isDefinedBy <https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntology> ;
                                      rdfs:label "Base Price"@en ;
                                      sd:SalesDistributionOntologyinModule sd:SalesDistributionOntologyPricingModule .


###  https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntologyBatch
sd:SalesDistributionOntologyBatch rdf:type owl:Class ;
                                  rdfs:subClassOf [ rdf:type owl:Restriction ;
                                                    owl:onProperty sd:SalesDistributionOntologyexpiryDate ;
                                                    owl:someValuesFrom xsd:date
                                                  ] ,
                                                  [ rdf:type owl:Restriction ;
                                                    owl:onProperty sd:SalesDistributionOntologymanufacturingDate ;
                                                    owl:someValuesFrom xsd:date
                                                  ] ;
                                  owl:hasKey ( sd:SalesDistributionOntologycode
                                             ) ;
                                  rdfs:comment "A uniquely identified quantity of a product manufactured together, tracked for traceability and expiry."@en ;
                                  rdfs:isDefinedBy <https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntology> ;
                                  rdfs:label "Batch"@en ;
                                  sd:SalesDistributionOntologyerpMapping "SAP: Batch (CHARG)" ;
                                  sd:SalesDistributionOntologyinModule sd:SalesDistributionOntologyMasterDataModule .


###  https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntologyBeat
sd:SalesDistributionOntologyBeat rdf:type owl:Class ;
                                 rdfs:subClassOf sd:SalesDistributionOntologyRoute ;
                                 rdfs:comment "A recurring, day-specific route of outlets visited by a field sales representative."@en ;
                                 rdfs:isDefinedBy <https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntology> ;
