                                                         owl:onProperty sd:SalesDistributionOntologyvisitDateTime ;
                                                         owl:someValuesFrom xsd:dateTime
                                                       ] ;
                                       rdfs:comment "An actual visit made by a sales representative to an outlet or customer."@en ;
                                       rdfs:isDefinedBy <https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntology> ;
