                                        sd:SalesDistributionOntologyinModule sd:SalesDistributionOntologyMasterDataModule .


###  https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntologyShipment
sd:SalesDistributionOntologyShipment rdf:type owl:Class ;
                                     rdfs:subClassOf [ rdf:type owl:Restriction ;
                                                       owl:onProperty sd:SalesDistributionOntologyshipsFrom ;
                                                       owl:someValuesFrom sd:SalesDistributionOntologyStorageLocation
                                                     ] ,
                                                     [ rdf:type owl:Restriction ;
                                                       owl:onProperty sd:SalesDistributionOntologyshipsTo ;
                                                       owl:someValuesFrom sd:SalesDistributionOntologyDeliveryPoint
                                                     ] ,
                                                     [ rdf:type owl:Restriction ;
                                                       owl:onProperty sd:SalesDistributionOntologycontainsShipmentLine ;
                                                       owl:minCardinality "1"^^xsd:nonNegativeInteger
                                                     ] ;
                                     rdfs:comment "A movement of goods from a source location to a destination, made up of shipment lines."@en ;
                                     rdfs:isDefinedBy <https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntology> ;
                                     rdfs:label "Shipment"@en ;
                                     sd:SalesDistributionOntologyinModule sd:SalesDistributionOntologyFulfillmentModule .


