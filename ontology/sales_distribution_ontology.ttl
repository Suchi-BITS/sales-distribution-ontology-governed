sd:SalesDistributionOntologyConsumerPromotion rdf:type owl:Class ;
                                              rdfs:subClassOf sd:SalesDistributionOntologyTradePromotion ;
                                              rdfs:comment "A promotion aimed at end consumers, such as extra-quantity packs or cashback."@en ;
                                              rdfs:isDefinedBy <https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntology> ;
                                              rdfs:label "Consumer Promotion"@en ;
                                              sd:SalesDistributionOntologyinModule sd:SalesDistributionOntologyTradePromotionModule .


###  https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntologyConversionFactor
sd:SalesDistributionOntologyConversionFactor rdf:type owl:Class ;
                                             rdfs:comment "A ratio for converting a quantity between two units of measure."@en ;
                                             rdfs:isDefinedBy <https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntology> ;
                                             rdfs:label "Conversion Factor"@en ;
                                             sd:SalesDistributionOntologyinModule sd:SalesDistributionOntologyMasterDataModule .


###  https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntologyCreditBlock
sd:SalesDistributionOntologyCreditBlock rdf:type owl:Class ;
                                        rdfs:comment "A restriction that prevents new orders or deliveries because of credit rules."@en ;
                                        rdfs:isDefinedBy <https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntology> ;
                                        rdfs:label "Credit Block"@en ;
                                        sd:SalesDistributionOntologyinModule sd:SalesDistributionOntologyCollectionsModule .


###  https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntologyCreditBlockedCustomer
sd:SalesDistributionOntologyCreditBlockedCustomer rdf:type owl:Class ;
                                                  owl:equivalentClass [ owl:intersectionOf ( sd:SalesDistributionOntologyCustomer
                                                                                             [ rdf:type owl:Restriction ;
                                                                                               owl:onProperty sd:SalesDistributionOntologyhasCreditProfile ;
                                                                                               owl:someValuesFrom [ owl:intersectionOf ( sd:SalesDistributionOntologyCreditProfile
                                                                                                                                         [ rdf:type owl:Restriction ;
                                                                                                                                           owl:onProperty sd:SalesDistributionOntologyhasCreditBlock ;
                                                                                                                                           owl:someValuesFrom sd:SalesDistributionOntologyCreditBlock
                                                                                                                                         ]
                                                                                                                                       ) ;
                                                                                                                    rdf:type owl:Class
                                                                                                                  ]
                                                                                             ]
                                                                                           ) ;
                                                                        rdf:type owl:Class
                                                                      ] ;
                                                  rdfs:comment "A customer whose credit profile carries an active credit block."@en ;
                                                  rdfs:isDefinedBy <https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntology> ;
                                                  rdfs:label "Credit Blocked Customer"@en .


###  https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntologyCreditExposure
sd:SalesDistributionOntologyCreditExposure rdf:type owl:Class ;
                                           rdfs:comment "The total credit risk a customer represents, including open orders, deliveries and invoices."@en ;
                                           rdfs:isDefinedBy <https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntology> ;
                                           rdfs:label "Credit Exposure"@en ;
                                           sd:SalesDistributionOntologyinModule sd:SalesDistributionOntologyCollectionsModule .


###  https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntologyCreditLimit
sd:SalesDistributionOntologyCreditLimit rdf:type owl:Class ;
                                        rdfs:comment "The maximum outstanding credit exposure allowed for a customer."@en ;
                                        rdfs:isDefinedBy <https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntology> ;
                                        rdfs:label "Credit Limit"@en ;
                                        sd:SalesDistributionOntologyerpMapping "SAP FSCM: Credit segment limit" ;
                                        sd:SalesDistributionOntologyinModule sd:SalesDistributionOntologyCollectionsModule .


###  https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntologyCreditNote
sd:SalesDistributionOntologyCreditNote rdf:type owl:Class ;
                                       rdfs:subClassOf [ rdf:type owl:Restriction ;
                                                         owl:onProperty sd:SalesDistributionOntologyissuedAgainst ;
                                                         owl:someValuesFrom sd:SalesDistributionOntologyInvoice
                                                       ] ;
                                       rdfs:comment "A document reducing the amount owed by a customer, for example for returns or claims."@en ;
                                       rdfs:isDefinedBy <https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntology> ;
                                       rdfs:label "Credit Note"@en ;
                                       skos:altLabel "CN"@en ;
                                       sd:SalesDistributionOntologyerpMapping "SAP SD: Credit memo (document category O)" ;
                                       sd:SalesDistributionOntologyinModule sd:SalesDistributionOntologyInvoicingModule .


###  https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntologyCreditProfile
sd:SalesDistributionOntologyCreditProfile rdf:type owl:Class ;
                                          rdfs:subClassOf [ rdf:type owl:Restriction ;
                                                            owl:onProperty sd:SalesDistributionOntologyhasCreditLimit ;
                                                            owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                                          ] ;
                                          rdfs:comment "The credit assessment and controls held for a customer."@en ;
                                          rdfs:isDefinedBy <https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntology> ;
                                          rdfs:label "Credit Profile"@en ;
                                          sd:SalesDistributionOntologyinModule sd:SalesDistributionOntologyCollectionsModule .


###  https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntologyCreditRule
sd:SalesDistributionOntologyCreditRule rdf:type owl:Class ;
                                       rdfs:subClassOf sd:SalesDistributionOntologyBusinessRule ;
                                       rdfs:comment "A rule determining credit limits, exposure and blocking."@en ;
                                       rdfs:isDefinedBy <https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntology> ;
                                       rdfs:label "Credit Rule"@en ;
                                       sd:SalesDistributionOntologyinModule sd:SalesDistributionOntologyOrderManagementModule .


###  https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntologyCustomer
sd:SalesDistributionOntologyCustomer rdf:type owl:Class ;
                                     rdfs:comment "A party that buys or receives products, or with whom commercial transactions are conducted."@en ;
                                     rdfs:isDefinedBy <https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntology> ;
                                     rdfs:label "Customer"@en ;
                                     sd:SalesDistributionOntologyerpMapping "SAP SD: Customer master (KNA1 / KNVV)" ;
                                     sd:SalesDistributionOntologyinModule sd:SalesDistributionOntologyMasterDataModule .


