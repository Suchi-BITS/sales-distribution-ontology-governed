###  https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntologyDistributor
sd:SalesDistributionOntologyDistributor rdf:type owl:Class ;
                                        rdfs:subClassOf sd:SalesDistributionOntologyChannelPartner ,
                                                        [ rdf:type owl:Restriction ;
                                                          owl:onProperty sd:SalesDistributionOntologybelongsToNetwork ;
                                                          owl:someValuesFrom sd:SalesDistributionOntologyDistributionNetwork
                                                        ] ,
                                                        [ rdf:type owl:Restriction ;
                                                          owl:onProperty sd:SalesDistributionOntologyhasCreditProfile ;
                                                          owl:someValuesFrom sd:SalesDistributionOntologyCreditProfile
                                                        ] ,
                                                        [ rdf:type owl:Restriction ;
                                                          owl:onProperty sd:SalesDistributionOntologyhasPaymentTerm ;
                                                          owl:someValuesFrom sd:SalesDistributionOntologyPaymentTerm
                                                        ] ,
                                                        [ rdf:type owl:Restriction ;
                                                          owl:onProperty sd:SalesDistributionOntologyoperatesIn ;
                                                          owl:someValuesFrom sd:SalesDistributionOntologyGeography
                                                        ] ;
                                        rdfs:comment "A channel partner appointed to buy from the brand owner (or a super stockist) and resell to downstream partners in an assigned territory."@en ;
                                        rdfs:isDefinedBy <https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntology> ;
                                        rdfs:label "Distributor"@en ;
                                        skos:altLabel "Channel Distributor"@en ,
                                                      "Dealer"@en ;
                                        sd:SalesDistributionOntologyinModule sd:SalesDistributionOntologyDistributorManagementModule .


