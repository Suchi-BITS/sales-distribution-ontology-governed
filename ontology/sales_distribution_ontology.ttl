sd:SalesDistributionOntologyReturnsModule rdf:type owl:Class ;
                                          rdfs:subClassOf sd:SalesDistributionOntologySalesDistributionManagement ;
                                          rdfs:comment "Capability for returns, replacements, claims and reverse logistics."@en ;
                                          rdfs:isDefinedBy <https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntology> ;
                                          rdfs:label "Returns Module"@en .


