sd:SalesDistributionOntologySecurityAndAuditModule rdf:type owl:Class ;
                                                   rdfs:subClassOf sd:SalesDistributionOntologySalesDistributionManagement ;
                                                   rdfs:comment "Capability for users, roles, permissions and audit trail."@en ;
                                                   rdfs:isDefinedBy <https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntology> ;
                                                   rdfs:label "Security And Audit Module"@en .


###  https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntologySerialNumber
sd:SalesDistributionOntologySerialNumber rdf:type owl:Class ;
                                         rdfs:comment "A unique identifier assigned to an individual unit of an item."@en ;
                                         rdfs:isDefinedBy <https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntology> ;
                                         rdfs:label "Serial Number"@en ;
                                         sd:SalesDistributionOntologyinModule sd:SalesDistributionOntologyMasterDataModule .


###  https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntologyServiceLevel
sd:SalesDistributionOntologyServiceLevel rdf:type owl:Class ;
                                         rdfs:subClassOf sd:SalesDistributionOntologyDistributionKPI ;
                                         rdfs:comment "A measure of how reliably customer orders are met."@en ;
                                         rdfs:isDefinedBy <https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntology> ;
                                         rdfs:label "Service Level"@en ;
                                         sd:SalesDistributionOntologyinModule sd:SalesDistributionOntologyAnalyticsModule .


###  https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntologySettlement
sd:SalesDistributionOntologySettlement rdf:type owl:Class ;
                                       rdfs:comment "The matching and clearing of payments, credits and deductions against invoices."@en ;
                                       rdfs:isDefinedBy <https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntology> ;
                                       rdfs:label "Settlement"@en ;
                                       sd:SalesDistributionOntologyinModule sd:SalesDistributionOntologyCollectionsModule .


###  https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntologyShelfLifeControlledProduct
sd:SalesDistributionOntologyShelfLifeControlledProduct rdf:type owl:Class ;
                                                       owl:equivalentClass [ owl:intersectionOf ( sd:SalesDistributionOntologyProduct
                                                                                                  [ rdf:type owl:Restriction ;
                                                                                                    owl:onProperty sd:SalesDistributionOntologyhasShelfLifePolicy ;
                                                                                                    owl:someValuesFrom sd:SalesDistributionOntologyShelfLifePolicy
                                                                                                  ]
                                                                                                ) ;
                                                                             rdf:type owl:Class
                                                                           ] ;
