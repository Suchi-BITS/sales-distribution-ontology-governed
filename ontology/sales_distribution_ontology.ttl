@prefix : <https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntology> .
@prefix sd: <https://abhigya.ai/ontology/sales-distribution#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sdi: <https://abhigya.ai/ontology/sales-distribution/data#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@base <https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntology> .

<https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntology> rdf:type owl:Ontology ;
                                                                            dcterms:description "Version 1.1.0 keeps all v1.0.0 classes and properties and adds: labels, definitions, synonyms and module tags for every term; property characteristics, hierarchies, inverses and property chains; class restrictions, defined classes, disjointness and keys; custom datatypes; and a synthetic sample dataset (individuals) for an FMCG brand owner selling through distributors."@en ;
                                                                            dcterms:modified "2026-09-30"^^xsd:date ;
                                                                            dcterms:title "Sales and Distribution Management Ontology"@en ;
                                                                            rdfs:comment "A domain ontology for sales, distribution, channel management, primary and secondary sales, inventory, order-to-cash, field sales, trade promotions, collections, returns, and distribution analytics."@en ;
                                                                            rdfs:label "Sales and Distribution Management Ontology"@en ;
                                                                            owl:versionInfo "1.1.0" ;
                                                                            skos:changeNote "1.1.0: added annotations, axioms, object/data properties and sample individuals. Widened the domain of sd:placedBy to include primary/secondary sales transactions; declared ChannelPartner as a subclass of Customer so that partners can place orders."@en .

#################################################################
#    Annotation properties
#################################################################

###  http://purl.org/dc/terms/description
dcterms:description rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/modified
dcterms:modified rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/title
dcterms:title rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2001/XMLSchema#maxInclusive
xsd:maxInclusive rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2001/XMLSchema#minInclusive
xsd:minInclusive rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#altLabel
skos:altLabel rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#changeNote
skos:changeNote rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#definition
skos:definition rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#example
skos:example rdf:type owl:AnnotationProperty .


###  https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntologyerpMapping
sd:SalesDistributionOntologyerpMapping rdf:type owl:AnnotationProperty ;
                                       rdfs:comment "Indicative mapping of a concept to typical ERP (SAP SD) objects or partner functions."@en ;
                                       rdfs:label "ERP mapping"@en .


###  https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntologyinModule
sd:SalesDistributionOntologyinModule rdf:type owl:AnnotationProperty ;
                                     rdfs:comment "Functional module (capability area) in which the term is primarily used."@en ;
                                     rdfs:label "in module"@en .


###  https://abhigya.ai/ontology/sales-distribution#erp
sd:erp rdf:type owl:AnnotationProperty .


###  https://abhigya.ai/ontology/sales-distribution#previous
sd:previous rdf:type owl:AnnotationProperty .


#################################################################
#    Datatypes
#################################################################

###  http://www.w3.org/2001/XMLSchema#date
xsd:date rdf:type rdfs:Datatype .


###  https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntologyNonNegativeDecimal
sd:SalesDistributionOntologyNonNegativeDecimal rdf:type rdfs:Datatype ;
                                               rdfs:comment "A decimal greater than or equal to zero."@en ;
                                               rdfs:label "Non-negative decimal"@en .


###  https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntologyPercentageValue
sd:SalesDistributionOntologyPercentageValue rdf:type rdfs:Datatype ;
                                            rdfs:comment "A decimal between 0 and 100 inclusive."@en ;
                                            rdfs:label "Percentage value"@en .


#################################################################
#    Object Properties
#################################################################

###  https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntologyaboutEntity
sd:SalesDistributionOntologyaboutEntity rdf:type owl:ObjectProperty ;
                                        rdfs:domain sd:SalesDistributionOntologyAuditEvent ;
                                        rdfs:comment "Entity to which an audit event refers."@en ;
                                        rdfs:isDefinedBy <https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntology> ;
                                        rdfs:label "about entity"@en .


###  https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntologyachievesTarget
sd:SalesDistributionOntologyachievesTarget rdf:type owl:ObjectProperty ;
                                           rdfs:domain sd:SalesDistributionOntologySalesActual ;
                                           rdfs:range sd:SalesDistributionOntologySalesTarget ;
                                           rdfs:comment "Target against which actual sales are measured."@en ;
                                           rdfs:isDefinedBy <https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntology> ;
                                           rdfs:label "achieves target"@en .


###  https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntologyagreementWith
sd:SalesDistributionOntologyagreementWith rdf:type owl:ObjectProperty ;
                                          rdfs:domain sd:SalesDistributionOntologyChannelAgreement ;
                                          rdfs:range sd:SalesDistributionOntologyChannelPartner ;
                                          rdfs:comment "The channel partner that is party to an agreement."@en ;
                                          rdfs:isDefinedBy <https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntology> ;
                                          rdfs:label "agreement with"@en .


###  https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntologyallocatedFrom
sd:SalesDistributionOntologyallocatedFrom rdf:type owl:ObjectProperty ;
                                          rdfs:domain sd:SalesDistributionOntologyOrderAllocation ;
                                          rdfs:range sd:SalesDistributionOntologyInventory ;
                                          rdfs:comment "Relates a order allocation (subject) to a inventory (object)."@en ;
                                          rdfs:isDefinedBy <https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntology> ;
                                          rdfs:label "allocated from"@en .


###  https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntologyappliesRule
sd:SalesDistributionOntologyappliesRule rdf:type owl:ObjectProperty ;
                                        rdfs:domain sd:SalesDistributionOntologyDiscount ;
                                        rdfs:range sd:SalesDistributionOntologyDiscountRule ;
                                        rdfs:comment "Discount rule that produced a discount."@en ;
                                        rdfs:isDefinedBy <https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntology> ;
                                        rdfs:label "applies rule"@en .


###  https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntologyappliesTaxRule
sd:SalesDistributionOntologyappliesTaxRule rdf:type owl:ObjectProperty ;
                                           rdfs:domain sd:SalesDistributionOntologyInvoice ;
                                           rdfs:range sd:SalesDistributionOntologyTaxRule ;
                                           rdfs:comment "Tax rule applied to an invoice."@en ;
                                           rdfs:isDefinedBy <https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntology> ;
                                           rdfs:label "applies tax rule"@en .


###  https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntologyappliesToCustomer
sd:SalesDistributionOntologyappliesToCustomer rdf:type owl:ObjectProperty ;
                                              rdfs:domain sd:SalesDistributionOntologyPrice ;
                                              rdfs:range sd:SalesDistributionOntologyCustomer ;
                                              rdfs:comment "Relates a price (subject) to a customer (object)."@en ;
                                              rdfs:isDefinedBy <https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntology> ;
                                              rdfs:label "applies to customer"@en .


###  https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntologyappliesToProduct
sd:SalesDistributionOntologyappliesToProduct rdf:type owl:ObjectProperty ;
                                             rdfs:domain sd:SalesDistributionOntologyPrice ;
                                             rdfs:range sd:SalesDistributionOntologyProduct ;
                                             rdfs:comment "Relates a price (subject) to a product (object)."@en ;
                                             rdfs:isDefinedBy <https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntology> ;
                                             rdfs:label "applies to product"@en .


###  https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntologyappointedBy
sd:SalesDistributionOntologyappointedBy rdf:type owl:ObjectProperty ;
                                        rdfs:domain sd:SalesDistributionOntologyDistributorAppointment ;
                                        rdfs:range sd:SalesDistributionOntologyBusinessOrganization ;
                                        rdfs:comment "Relates a distributor appointment (subject) to a business organization (object)."@en ;
                                        rdfs:isDefinedBy <https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntology> ;
                                        rdfs:label "appointed by"@en .


###  https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntologyappointsDistributor
sd:SalesDistributionOntologyappointsDistributor rdf:type owl:ObjectProperty ;
                                                rdfs:subPropertyOf sd:SalesDistributionOntologyhasDistributor ;
                                                rdfs:domain sd:SalesDistributionOntologyBusinessOrganization ;
                                                rdfs:range sd:SalesDistributionOntologyDistributor ;
                                                rdfs:comment "Relates a business organization (subject) to a distributor (object)."@en ;
                                                rdfs:isDefinedBy <https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntology> ;
                                                rdfs:label "appoints distributor"@en .


###  https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntologyarisesFromReturn
sd:SalesDistributionOntologyarisesFromReturn rdf:type owl:ObjectProperty ;
                                             rdfs:domain sd:SalesDistributionOntologyClaim ;
                                             rdfs:range sd:SalesDistributionOntologyReturnOrder ;
                                             rdfs:comment "Return order from which a claim arises."@en ;
                                             rdfs:isDefinedBy <https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntology> ;
                                             rdfs:label "arises from return"@en .


###  https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntologyassignedTo
sd:SalesDistributionOntologyassignedTo rdf:type owl:ObjectProperty ;
                                       rdfs:range sd:SalesDistributionOntologyEmployee ;
                                       rdfs:comment "Relates a work item (territory, beat, target, route) to the employee responsible for it."@en ;
                                       rdfs:isDefinedBy <https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntology> ;
                                       rdfs:label "assigned to"@en .


###  https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntologyattendanceOf
sd:SalesDistributionOntologyattendanceOf rdf:type owl:ObjectProperty ,
                                                  owl:FunctionalProperty ;
                                         rdfs:domain sd:SalesDistributionOntologyAttendance ;
                                         rdfs:range sd:SalesDistributionOntologyEmployee ;
                                         rdfs:comment "Employee to whom an attendance record belongs."@en ;
                                         rdfs:isDefinedBy <https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntology> ;
                                         rdfs:label "attendance of"@en .


###  https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntologyauthorizedBy
sd:SalesDistributionOntologyauthorizedBy rdf:type owl:ObjectProperty ;
                                         rdfs:domain sd:SalesDistributionOntologyReturnAuthorization ;
                                         rdfs:range sd:SalesDistributionOntologyEmployee ;
                                         rdfs:comment "Employee who approved a return authorization."@en ;
                                         rdfs:isDefinedBy <https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntology> ;
                                         rdfs:label "authorized by"@en .


###  https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntologyauthorizesReturn
sd:SalesDistributionOntologyauthorizesReturn rdf:type owl:ObjectProperty ;
                                             rdfs:domain sd:SalesDistributionOntologyReturnAuthorization ;
                                             rdfs:range sd:SalesDistributionOntologyReturnOrder ;
                                             rdfs:comment "Relates a return authorization (subject) to a return order (object)."@en ;
                                             rdfs:isDefinedBy <https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntology> ;
                                             rdfs:label "authorizes return"@en .


###  https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntologybasedOn
sd:SalesDistributionOntologybasedOn rdf:type owl:ObjectProperty ;
                                    rdfs:domain sd:SalesDistributionOntologySalesForecast ;
                                    rdfs:range sd:SalesDistributionOntologyDemandSignal ;
                                    rdfs:comment "Relates a sales forecast (subject) to a demand signal (object)."@en ;
                                    rdfs:isDefinedBy <https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntology> ;
                                    rdfs:label "based on"@en .


###  https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntologybelongsToBeat
sd:SalesDistributionOntologybelongsToBeat rdf:type owl:ObjectProperty ;
                                          owl:inverseOf sd:SalesDistributionOntologyhasOutlet ;
                                          rdfs:domain sd:SalesDistributionOntologyOutlet ;
                                          rdfs:range sd:SalesDistributionOntologyBeat ;
                                          rdfs:comment "Relates a outlet (subject) to a beat (object)."@en ;
                                          rdfs:isDefinedBy <https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntology> ;
                                          rdfs:label "belongs to beat"@en .


###  https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntologybelongsToCategory
sd:SalesDistributionOntologybelongsToCategory rdf:type owl:ObjectProperty ;
                                              rdfs:domain sd:SalesDistributionOntologyProduct ;
                                              rdfs:range sd:SalesDistributionOntologyProductCategory ;
                                              rdfs:comment "Relates a product (subject) to a product category (object)."@en ;
                                              rdfs:isDefinedBy <https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntology> ;
                                              rdfs:label "belongs to category"@en .


###  https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntologybelongsToInvoice
sd:SalesDistributionOntologybelongsToInvoice rdf:type owl:ObjectProperty ;
                                             owl:inverseOf sd:SalesDistributionOntologyhasInvoiceLine ;
                                             rdf:type owl:FunctionalProperty ;
                                             rdfs:domain sd:SalesDistributionOntologyInvoiceLine ;
                                             rdfs:range sd:SalesDistributionOntologyInvoice ;
                                             rdfs:comment "Invoice to which a line belongs."@en ;
                                             rdfs:isDefinedBy <https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntology> ;
                                             rdfs:label "belongs to invoice"@en .


###  https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntologybelongsToNetwork
sd:SalesDistributionOntologybelongsToNetwork rdf:type owl:ObjectProperty ;
                                             rdfs:domain sd:SalesDistributionOntologyChannelPartner ;
                                             rdfs:range sd:SalesDistributionOntologyDistributionNetwork ;
                                             rdfs:comment "Relates a channel partner (subject) to a distribution network (object)."@en ;
                                             rdfs:isDefinedBy <https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntology> ;
                                             rdfs:label "belongs to network"@en .


###  https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntologybelongsToReturn
sd:SalesDistributionOntologybelongsToReturn rdf:type owl:ObjectProperty ;
                                            owl:inverseOf sd:SalesDistributionOntologyhasReturnLine ;
                                            rdf:type owl:FunctionalProperty ;
                                            rdfs:domain sd:SalesDistributionOntologyReturnOrderLine ;
                                            rdfs:range sd:SalesDistributionOntologyReturnOrder ;
                                            rdfs:comment "Return order to which a line belongs."@en ;
                                            rdfs:isDefinedBy <https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntology> ;
                                            rdfs:label "belongs to return"@en .


###  https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntologycapturedOrder
sd:SalesDistributionOntologycapturedOrder rdf:type owl:ObjectProperty ;
                                          rdfs:domain sd:SalesDistributionOntologySalesVisit ;
                                          rdfs:range sd:SalesDistributionOntologySalesOrder ;
                                          rdfs:comment "Order captured during a visit."@en ;
                                          rdfs:isDefinedBy <https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntology> ;
                                          rdfs:label "captured order"@en .


###  https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntologycapturedThrough
sd:SalesDistributionOntologycapturedThrough rdf:type owl:ObjectProperty ,
                                                     owl:FunctionalProperty ;
                                            rdfs:domain sd:SalesDistributionOntologySalesOrder ;
                                            rdfs:range sd:SalesDistributionOntologyOrderChannel ;
                                            rdfs:comment "Relates a sales order (subject) to a order channel (object)."@en ;
                                            rdfs:isDefinedBy <https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntology> ;
                                            rdfs:label "captured through"@en .


###  https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntologycarriesShipment
sd:SalesDistributionOntologycarriesShipment rdf:type owl:ObjectProperty ;
                                            rdfs:domain sd:SalesDistributionOntologyDeliveryTrip ;
                                            rdfs:range sd:SalesDistributionOntologyShipment ;
                                            rdfs:comment "Shipment carried on a trip."@en ;
                                            rdfs:isDefinedBy <https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntology> ;
                                            rdfs:label "carries shipment"@en .


###  https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntologychecksAvailability
sd:SalesDistributionOntologychecksAvailability rdf:type owl:ObjectProperty ;
                                               rdfs:domain sd:SalesDistributionOntologySalesOrder ;
                                               rdfs:range sd:SalesDistributionOntologyAvailabilityCheck ;
                                               rdfs:comment "Relates a sales order (subject) to a availability check (object)."@en ;
                                               rdfs:isDefinedBy <https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntology> ;
                                               rdfs:label "checks availability"@en .


###  https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntologyclaimedBy
sd:SalesDistributionOntologyclaimedBy rdf:type owl:ObjectProperty ;
                                      rdfs:domain sd:SalesDistributionOntologyClaim ;
                                      rdfs:range sd:SalesDistributionOntologyChannelPartner ;
                                      rdfs:comment "Channel partner that raised a claim."@en ;
                                      rdfs:isDefinedBy <https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntology> ;
                                      rdfs:label "claimed by"@en .


###  https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntologycollectedBy
sd:SalesDistributionOntologycollectedBy rdf:type owl:ObjectProperty ;
                                        rdfs:domain sd:SalesDistributionOntologyCollection ;
                                        rdfs:range sd:SalesDistributionOntologyEmployee ;
                                        rdfs:comment "Employee who performed a collection."@en ;
                                        rdfs:isDefinedBy <https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntology> ;
                                        rdfs:label "collected by"@en .


###  https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntologyconcernsBatch
sd:SalesDistributionOntologyconcernsBatch rdf:type owl:ObjectProperty ;
                                          rdfs:domain [ rdf:type owl:Class ;
                                                        owl:unionOf ( sd:SalesDistributionOntologyExpiryStock
                                                                      sd:SalesDistributionOntologyNearExpiryStock
                                                                    )
                                                      ] ;
                                          rdfs:range sd:SalesDistributionOntologyBatch ;
                                          rdfs:comment "Batch to which expiry stock relates."@en ;
                                          rdfs:isDefinedBy <https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntology> ;
                                          rdfs:label "concerns batch"@en .


###  https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntologyconductedBy
sd:SalesDistributionOntologyconductedBy rdf:type owl:ObjectProperty ;
                                        owl:inverseOf sd:SalesDistributionOntologyhasSalesVisit ;
                                        rdf:type owl:FunctionalProperty ;
                                        rdfs:domain sd:SalesDistributionOntologySalesVisit ;
                                        rdfs:range sd:SalesDistributionOntologySalesRepresentative ;
                                        rdfs:comment "Sales representative who conducted the visit."@en ;
                                        rdfs:isDefinedBy <https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntology> ;
                                        rdfs:label "conducted by"@en .


###  https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntologycontainsProduct
sd:SalesDistributionOntologycontainsProduct rdf:type owl:ObjectProperty ;
                                            rdfs:domain sd:SalesDistributionOntologyProductBundle ;
                                            rdfs:range sd:SalesDistributionOntologyProduct ;
                                            rdfs:comment "A product that is part of a product bundle."@en ;
                                            rdfs:isDefinedBy <https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntology> ;
                                            rdfs:label "contains product"@en .


###  https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntologycontainsShipmentLine
sd:SalesDistributionOntologycontainsShipmentLine rdf:type owl:ObjectProperty ,
                                                          owl:InverseFunctionalProperty ;
                                                 rdfs:domain sd:SalesDistributionOntologyShipment ;
                                                 rdfs:range sd:SalesDistributionOntologyShipmentLine ;
                                                 rdfs:comment "Relates a shipment (subject) to a shipment line (object)."@en ;
                                                 rdfs:isDefinedBy <https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntology> ;
                                                 rdfs:label "contains shipment line"@en .


###  https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntologyconvertedTo
sd:SalesDistributionOntologyconvertedTo rdf:type owl:ObjectProperty ;
                                        rdfs:domain sd:SalesDistributionOntologyLead ;
                                        rdfs:range sd:SalesDistributionOntologyOpportunity ;
                                        rdfs:comment "Opportunity created from a lead."@en ;
                                        rdfs:isDefinedBy <https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntology> ;
                                        rdfs:label "converted to"@en .


###  https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntologycountsInventory
sd:SalesDistributionOntologycountsInventory rdf:type owl:ObjectProperty ;
                                            rdfs:domain [ rdf:type owl:Class ;
                                                          owl:unionOf ( sd:SalesDistributionOntologyCycleCount
                                                                        sd:SalesDistributionOntologyStockTake
                                                                      )
                                                        ] ;
                                            rdfs:range sd:SalesDistributionOntologyInventory ;
                                            rdfs:comment "Inventory record verified by a count."@en ;
                                            rdfs:isDefinedBy <https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntology> ;
                                            rdfs:label "counts inventory"@en .


###  https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntologycoveredBy
sd:SalesDistributionOntologycoveredBy rdf:type owl:ObjectProperty ;
                                      rdfs:domain sd:SalesDistributionOntologyOutlet ;
                                      rdfs:range sd:SalesDistributionOntologyEmployee ;
                                      owl:propertyChainAxiom ( sd:SalesDistributionOntologybelongsToBeat
                                                               sd:SalesDistributionOntologyassignedTo
                                                             ) ;
                                      rdfs:comment "Employee who covers an outlet through its beat (derived)."@en ;
                                      rdfs:isDefinedBy <https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntology> ;
                                      rdfs:label "covered by"@en .


###  https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntologycoversTerritory
sd:SalesDistributionOntologycoversTerritory rdf:type owl:ObjectProperty ;
                                            rdfs:domain sd:SalesDistributionOntologyPartnerRelationship ;
                                            rdfs:range sd:SalesDistributionOntologyTerritory ;
                                            rdfs:comment "Territory covered by a partner relationship."@en ;
                                            rdfs:isDefinedBy <https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntology> ;
                                            rdfs:label "covers territory"@en .


###  https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntologydefinesEligibilityFor
sd:SalesDistributionOntologydefinesEligibilityFor rdf:type owl:ObjectProperty ;
                                                  rdfs:domain sd:SalesDistributionOntologyPromotionEligibility ;
                                                  rdfs:range sd:SalesDistributionOntologyTradePromotion ;
                                                  rdfs:comment "Promotion for which an eligibility rule applies."@en ;
                                                  rdfs:isDefinedBy <https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntology> ;
                                                  rdfs:label "defines eligibility for"@en .


###  https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntologydelivers
sd:SalesDistributionOntologydelivers rdf:type owl:ObjectProperty ;
                                     rdfs:domain sd:SalesDistributionOntologyDelivery ;
                                     rdfs:range sd:SalesDistributionOntologySalesOrder ;
                                     rdfs:comment "Relates a delivery (subject) to a sales order (object)."@en ;
                                     rdfs:isDefinedBy <https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntology> ;
                                     rdfs:label "delivers"@en .


###  https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntologydeliveryPointOf
sd:SalesDistributionOntologydeliveryPointOf rdf:type owl:ObjectProperty ;
                                            owl:inverseOf sd:SalesDistributionOntologyhasDeliveryPoint ;
                                            rdfs:comment "Inverse of has delivery point."@en ;
                                            rdfs:isDefinedBy <https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntology> ;
                                            rdfs:label "delivery point of"@en .


###  https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntologydistributesProduct
sd:SalesDistributionOntologydistributesProduct rdf:type owl:ObjectProperty ;
                                               rdfs:domain sd:SalesDistributionOntologyDistributor ;
                                               rdfs:range sd:SalesDistributionOntologyProduct ;
                                               rdfs:comment "Relates a distributor (subject) to a product (object)."@en ;
                                               rdfs:isDefinedBy <https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntology> ;
                                               rdfs:label "distributes product"@en .


###  https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntologydistributesTo
sd:SalesDistributionOntologydistributesTo rdf:type owl:ObjectProperty ,
                                                   owl:IrreflexiveProperty ;
                                          rdfs:domain sd:SalesDistributionOntologyBusinessOrganization ;
                                          rdfs:range sd:SalesDistributionOntologyChannelPartner ;
                                          rdfs:comment "An organization distributes goods to a downstream channel partner."@en ;
                                          rdfs:isDefinedBy <https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntology> ;
                                          rdfs:label "distributes to"@en .


###  https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntologyeligibleFor
