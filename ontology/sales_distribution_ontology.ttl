                                      rdfs:label "Deduction"@en ;
                                      sd:SalesDistributionOntologyinModule sd:SalesDistributionOntologyCollectionsModule .


###  https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntologyDeliveredOrder
sd:SalesDistributionOntologyDeliveredOrder rdf:type owl:Class ;
                                           owl:equivalentClass [ owl:intersectionOf ( sd:SalesDistributionOntologySalesOrder
                                                                                      [ rdf:type owl:Restriction ;
                                                                                        owl:onProperty [ owl:inverseOf sd:SalesDistributionOntologydelivers
                                                                                                       ] ;
                                                                                        owl:someValuesFrom sd:SalesDistributionOntologyDelivery
                                                                                      ]
                                                                                    ) ;
                                                                 rdf:type owl:Class
                                                               ] ;
                                           rdfs:comment "A sales order for which at least one delivery exists."@en ;
                                           rdfs:isDefinedBy <https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntology> ;
                                           rdfs:label "Delivered Order"@en .


