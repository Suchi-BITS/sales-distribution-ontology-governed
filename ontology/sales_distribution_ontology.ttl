sd:SalesDistributionOntologyRevenueTarget rdf:type owl:Class ;
                                          rdfs:subClassOf sd:SalesDistributionOntologySalesTarget ;
                                          rdfs:comment "A target expressed in monetary value."@en ;
                                          rdfs:isDefinedBy <https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntology> ;
                                          rdfs:label "Revenue Target"@en ;
                                          sd:SalesDistributionOntologyinModule sd:SalesDistributionOntologyTargetAndForecastModule .


###  https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntologyReverseLogistics
sd:SalesDistributionOntologyReverseLogistics rdf:type owl:Class ;
                                             rdfs:comment "The flow of returned goods for restocking, rework, resale or disposal."@en ;
                                             rdfs:isDefinedBy <https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntology> ;
