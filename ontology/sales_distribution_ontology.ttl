###  https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntologyOrderManagementModule
sd:SalesDistributionOntologyOrderManagementModule rdf:type owl:Class ;
                                                  rdfs:subClassOf sd:SalesDistributionOntologySalesDistributionManagement ;
                                                  rdfs:comment "Capability for capturing, validating, allocating and tracking orders."@en ;
                                                  rdfs:isDefinedBy <https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntology> ;
                                                  rdfs:label "Order Management Module"@en .


###  https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntologyOrderOnCreditHold
sd:SalesDistributionOntologyOrderOnCreditHold rdf:type owl:Class ;
                                              owl:equivalentClass [ owl:intersectionOf ( sd:SalesDistributionOntologySalesOrder
                                                                                         [ rdf:type owl:Restriction ;
                                                                                           owl:onProperty sd:SalesDistributionOntologyhasHold ;
                                                                                           owl:someValuesFrom sd:SalesDistributionOntologyOrderHold
                                                                                         ]
                                                                                       ) ;
                                                                    rdf:type owl:Class
                                                                  ] ;
                                              rdfs:comment "A sales order that is on hold."@en ;
                                              rdfs:isDefinedBy <https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntology> ;
                                              rdfs:label "Order On Credit Hold"@en .


###  https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntologyOrderSource
sd:SalesDistributionOntologyOrderSource rdf:type owl:Class ;
                                        rdfs:comment "The originator of an order, such as a sales representative, a distributor or an automated system."@en ;
                                        rdfs:isDefinedBy <https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntology> ;
                                        rdfs:label "Order Source"@en ;
                                        sd:SalesDistributionOntologyinModule sd:SalesDistributionOntologyOrderManagementModule .


###  https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntologyOrderStatus
sd:SalesDistributionOntologyOrderStatus rdf:type owl:Class ;
                                        rdfs:comment "A lifecycle state of a sales order such as draft, approved, delivered or cancelled."@en ;
                                        rdfs:isDefinedBy <https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntology> ;
                                        rdfs:label "Order Status"@en ;
                                        sd:SalesDistributionOntologyinModule sd:SalesDistributionOntologyOrderManagementModule .


###  https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntologyOrderType
sd:SalesDistributionOntologyOrderType rdf:type owl:Class ;
                                      rdfs:comment "A classification of sales orders such as standard, urgent, replenishment or key-account."@en ;
                                      rdfs:isDefinedBy <https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntology> ;
                                      rdfs:label "Order Type"@en ;
                                      sd:SalesDistributionOntologyinModule sd:SalesDistributionOntologyOrderManagementModule .


###  https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntologyOrderWithReturns
sd:SalesDistributionOntologyOrderWithReturns rdf:type owl:Class ;
                                             owl:equivalentClass [ owl:intersectionOf ( sd:SalesDistributionOntologySalesOrder
                                                                                        [ rdf:type owl:Restriction ;
                                                                                          owl:onProperty [ owl:inverseOf sd:SalesDistributionOntologyreturnsAgainst
                                                                                                         ] ;
                                                                                          owl:someValuesFrom sd:SalesDistributionOntologyReturnOrder
                                                                                        ]
                                                                                      ) ;
                                                                   rdf:type owl:Class
                                                                 ] ;
                                             rdfs:comment "A sales order against which at least one return order exists."@en ;
                                             rdfs:isDefinedBy <https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntology> ;
                                             rdfs:label "Order With Returns"@en .


###  https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntologyOutlet
sd:SalesDistributionOntologyOutlet rdf:type owl:Class ;
                                   rdfs:subClassOf sd:SalesDistributionOntologyRetailer ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty sd:SalesDistributionOntologybelongsToBeat ;
                                                     owl:someValuesFrom sd:SalesDistributionOntologyBeat
                                                   ] ;
                                   rdfs:comment "A physical point of sale (store) that is visited, serviced and supplied as part of route-to-market coverage."@en ;
                                   rdfs:isDefinedBy <https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntology> ;
                                   rdfs:label "Outlet"@en ;
                                   skos:altLabel "Point of Sale"@en ,
                                                 "Store"@en ;
                                   sd:SalesDistributionOntologyinModule sd:SalesDistributionOntologyRouteToMarketModule .


###  https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntologyOutletCoverageTarget
sd:SalesDistributionOntologyOutletCoverageTarget rdf:type owl:Class ;
                                                 rdfs:subClassOf sd:SalesDistributionOntologySalesTarget ;
                                                 rdfs:comment "A target for the number or share of outlets to be covered or activated."@en ;
                                                 rdfs:isDefinedBy <https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntology> ;
                                                 rdfs:label "Outlet Coverage Target"@en ;
                                                 sd:SalesDistributionOntologyinModule sd:SalesDistributionOntologyTargetAndForecastModule .


###  https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntologyOutstandingBalance
sd:SalesDistributionOntologyOutstandingBalance rdf:type owl:Class ;
                                               rdfs:comment "The unpaid amount owed by a customer."@en ;
                                               rdfs:isDefinedBy <https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntology> ;
                                               rdfs:label "Outstanding Balance"@en ;
                                               sd:SalesDistributionOntologyinModule sd:SalesDistributionOntologyCollectionsModule .


###  https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntologyOverdueReceivable
sd:SalesDistributionOntologyOverdueReceivable rdf:type owl:Class ;
                                              rdfs:subClassOf sd:SalesDistributionOntologyAccountsReceivable ;
                                              rdfs:comment "A receivable past its due date."@en ;
                                              rdfs:isDefinedBy <https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntology> ;
                                              rdfs:label "Overdue Receivable"@en ;
                                              sd:SalesDistributionOntologyinModule sd:SalesDistributionOntologyCollectionsModule .


###  https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntologyPOSSystem
sd:SalesDistributionOntologyPOSSystem rdf:type owl:Class ;
                                      rdfs:subClassOf sd:SalesDistributionOntologyExternalSystem ;
                                      rdfs:comment "A point-of-sale system capturing retail transactions."@en ;
                                      rdfs:isDefinedBy <https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntology> ;
                                      rdfs:label "POS system"@en ;
                                      sd:SalesDistributionOntologyinModule sd:SalesDistributionOntologyIntegrationModule .


###  https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntologyPartnerRelationship
sd:SalesDistributionOntologyPartnerRelationship rdf:type owl:Class ;
                                                rdfs:comment "A formal relationship between the brand owner and a channel partner."@en ;
                                                rdfs:isDefinedBy <https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntology> ;
                                                rdfs:label "Partner Relationship"@en ;
                                                sd:SalesDistributionOntologyinModule sd:SalesDistributionOntologyDistributorManagementModule .


###  https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntologyPayer
sd:SalesDistributionOntologyPayer rdf:type owl:Class ;
                                  rdfs:subClassOf sd:SalesDistributionOntologyCustomer ;
                                  rdfs:comment "The customer role that settles the invoice."@en ;
                                  rdfs:isDefinedBy <https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntology> ;
                                  rdfs:label "Payer"@en ;
                                  sd:SalesDistributionOntologyerpMapping "SAP SD: Partner function RG (Payer)" ;
                                  sd:SalesDistributionOntologyinModule sd:SalesDistributionOntologyMasterDataModule .


###  https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntologyPayment
sd:SalesDistributionOntologyPayment rdf:type owl:Class ;
                                    rdfs:subClassOf [ rdf:type owl:Restriction ;
                                                      owl:onProperty sd:SalesDistributionOntologypaidBy ;
                                                      owl:someValuesFrom sd:SalesDistributionOntologyCustomer
                                                    ] ,
                                                    [ rdf:type owl:Restriction ;
                                                      owl:onProperty sd:SalesDistributionOntologypaymentDate ;
                                                      owl:someValuesFrom xsd:date
                                                    ] ;
                                    rdfs:comment "A monetary payment made by a customer against one or more invoices."@en ;
                                    rdfs:isDefinedBy <https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntology> ;
                                    rdfs:label "Payment"@en ;
                                    sd:SalesDistributionOntologyinModule sd:SalesDistributionOntologyCollectionsModule .


###  https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntologyPaymentMethod
sd:SalesDistributionOntologyPaymentMethod rdf:type owl:Class ;
                                          rdfs:comment "The instrument by which a payment is made, such as bank transfer, UPI or cheque."@en ;
                                          rdfs:isDefinedBy <https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntology> ;
                                          rdfs:label "Payment Method"@en ;
                                          sd:SalesDistributionOntologyinModule sd:SalesDistributionOntologyCollectionsModule .


###  https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntologyPaymentTerm
sd:SalesDistributionOntologyPaymentTerm rdf:type owl:Class ;
                                        rdfs:comment "The terms under which a customer must pay an invoice."@en ;
                                        rdfs:isDefinedBy <https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntology> ;
                                        rdfs:label "Payment Term"@en ;
                                        sd:SalesDistributionOntologyerpMapping "SAP: Terms of payment (ZTERM)" ;
                                        sd:SalesDistributionOntologyinModule sd:SalesDistributionOntologyCollectionsModule .


###  https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntologyPaymentTermDefinition
sd:SalesDistributionOntologyPaymentTermDefinition rdf:type owl:Class ;
                                                  rdfs:subClassOf sd:SalesDistributionOntologyPaymentTerm ;
                                                  rdfs:comment "A defined payment term such as net 30 days or cash on delivery."@en ;
                                                  rdfs:isDefinedBy <https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntology> ;
                                                  rdfs:label "Payment Term Definition"@en ;
                                                  sd:SalesDistributionOntologyinModule sd:SalesDistributionOntologyCollectionsModule .


###  https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntologyPermission
sd:SalesDistributionOntologyPermission rdf:type owl:Class ;
                                       rdfs:comment "An authorization to perform an action on a resource."@en ;
                                       rdfs:isDefinedBy <https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntology> ;
                                       rdfs:label "Permission"@en ;
                                       sd:SalesDistributionOntologyinModule sd:SalesDistributionOntologySecurityAndAuditModule .


###  https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntologyPerson
sd:SalesDistributionOntologyPerson rdf:type owl:Class ;
                                   rdfs:comment "A human being involved in the sales and distribution process."@en ;
                                   rdfs:isDefinedBy <https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntology> ;
                                   rdfs:label "Person"@en ;
                                   sd:SalesDistributionOntologyinModule sd:SalesDistributionOntologyFieldSalesModule .


###  https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntologyPrice
sd:SalesDistributionOntologyPrice rdf:type owl:Class ;
                                  rdfs:subClassOf [ rdf:type owl:Restriction ;
                                                    owl:onProperty sd:SalesDistributionOntologyappliesToProduct ;
                                                    owl:someValuesFrom sd:SalesDistributionOntologyProduct
                                                  ] ,
                                                  [ rdf:type owl:Restriction ;
                                                    owl:onProperty sd:SalesDistributionOntologyunitPrice ;
                                                    owl:someValuesFrom xsd:decimal
                                                  ] ;
                                  rdfs:comment "The monetary value at which a product is sold under given conditions."@en ;
                                  rdfs:isDefinedBy <https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntology> ;
                                  rdfs:label "Price"@en ;
                                  sd:SalesDistributionOntologyinModule sd:SalesDistributionOntologyPricingModule .


###  https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntologyPriceList
sd:SalesDistributionOntologyPriceList rdf:type owl:Class ;
                                      rdfs:subClassOf [ rdf:type owl:Restriction ;
                                                        owl:onProperty sd:SalesDistributionOntologyhasPrice ;
                                                        owl:minCardinality "1"^^xsd:nonNegativeInteger
                                                      ] ;
                                      rdfs:comment "A collection of prices valid for a set of products, customers and period."@en ;
                                      rdfs:isDefinedBy <https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntology> ;
                                      rdfs:label "Price List"@en ;
                                      sd:SalesDistributionOntologyerpMapping "SAP SD: Price list type (PLTYP) / condition records" ;
                                      sd:SalesDistributionOntologyinModule sd:SalesDistributionOntologyPricingModule .


###  https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntologyPricingModule
sd:SalesDistributionOntologyPricingModule rdf:type owl:Class ;
                                          rdfs:subClassOf sd:SalesDistributionOntologySalesDistributionManagement ;
                                          rdfs:comment "Capability for price lists, conditions, discounts and price determination."@en ;
                                          rdfs:isDefinedBy <https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntology> ;
                                          rdfs:label "Pricing Module"@en .


###  https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntologyPricingRule
sd:SalesDistributionOntologyPricingRule rdf:type owl:Class ;
                                        rdfs:subClassOf sd:SalesDistributionOntologyBusinessRule ;
                                        rdfs:comment "A rule determining how prices are calculated or restricted."@en ;
                                        rdfs:isDefinedBy <https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntology> ;
                                        rdfs:label "Pricing Rule"@en ;
                                        sd:SalesDistributionOntologyinModule sd:SalesDistributionOntologyOrderManagementModule .


###  https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntologyPrimarySale
sd:SalesDistributionOntologyPrimarySale rdf:type owl:Class ;
                                        rdfs:comment "Sale from manufacturer/brand owner to distributor, super-stockist, stockist or another first-level channel partner."@en ;
                                        rdfs:isDefinedBy <https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntology> ;
                                        rdfs:label "Primary Sale"@en ;
                                        skos:altLabel "Primary Sales"@en ,
                                                      "Sell-in"@en ;
                                        sd:SalesDistributionOntologyinModule sd:SalesDistributionOntologyPrimarySalesModule .


###  https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntologyPrimarySalesModule
sd:SalesDistributionOntologyPrimarySalesModule rdf:type owl:Class ;
                                               rdfs:subClassOf sd:SalesDistributionOntologySalesDistributionManagement ;
                                               rdfs:comment "Capability for managing sales from the brand owner to first-level partners."@en ;
                                               rdfs:isDefinedBy <https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntology> ;
                                               rdfs:label "Primary Sales Module"@en .


###  https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntologyPrimarySalesOrder
sd:SalesDistributionOntologyPrimarySalesOrder rdf:type owl:Class ;
                                              rdfs:subClassOf sd:SalesDistributionOntologyPrimarySalesTransaction ,
                                                              sd:SalesDistributionOntologySalesOrder ;
                                              owl:disjointWith sd:SalesDistributionOntologySecondarySalesOrder ;
                                              rdfs:comment "A sales order placed by a first-level channel partner on the brand owner."@en ;
                                              rdfs:isDefinedBy <https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntology> ;
                                              rdfs:label "Primary Sales Order"@en ;
                                              sd:SalesDistributionOntologyinModule sd:SalesDistributionOntologyOrderManagementModule .


###  https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntologyPrimarySalesTransaction
sd:SalesDistributionOntologyPrimarySalesTransaction rdf:type owl:Class ;
                                                    rdfs:subClassOf sd:SalesDistributionOntologyPrimarySale ,
                                                                    [ rdf:type owl:Restriction ;
                                                                      owl:onProperty sd:SalesDistributionOntologyplacedBy ;
                                                                      owl:someValuesFrom sd:SalesDistributionOntologyDistributor
                                                                    ] ;
                                                    rdfs:comment "A primary sale event between the brand owner and a first-level channel partner."@en ;
                                                    rdfs:isDefinedBy <https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntology> ;
                                                    rdfs:label "Primary Sales Transaction"@en ;
                                                    sd:SalesDistributionOntologyinModule sd:SalesDistributionOntologyPrimarySalesModule .


###  https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntologyProduct
sd:SalesDistributionOntologyProduct rdf:type owl:Class ;
                                    rdfs:comment "An item or offering that is sold, stocked or distributed."@en ;
                                    rdfs:isDefinedBy <https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntology> ;
                                    rdfs:label "Product"@en ;
                                    sd:SalesDistributionOntologyerpMapping "SAP: Material master (MARA)" ;
                                    sd:SalesDistributionOntologyinModule sd:SalesDistributionOntologyMasterDataModule .


###  https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntologyProductBrand
sd:SalesDistributionOntologyProductBrand rdf:type owl:Class ;
                                         rdfs:comment "A brand under which products are marketed."@en ;
                                         rdfs:isDefinedBy <https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntology> ;
                                         rdfs:label "Product Brand"@en ;
                                         sd:SalesDistributionOntologyinModule sd:SalesDistributionOntologyMasterDataModule .


###  https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntologyProductBundle
sd:SalesDistributionOntologyProductBundle rdf:type owl:Class ;
                                          rdfs:subClassOf sd:SalesDistributionOntologyProduct ;
                                          rdfs:comment "A set of products sold together as a single offering."@en ;
                                          rdfs:isDefinedBy <https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntology> ;
                                          rdfs:label "Product Bundle"@en ;
                                          sd:SalesDistributionOntologyinModule sd:SalesDistributionOntologyMasterDataModule .


###  https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntologyProductCategory
sd:SalesDistributionOntologyProductCategory rdf:type owl:Class ;
                                            rdfs:comment "A grouping of products in the merchandise hierarchy."@en ;
                                            rdfs:isDefinedBy <https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntology> ;
                                            rdfs:label "Product Category"@en ;
                                            sd:SalesDistributionOntologyinModule sd:SalesDistributionOntologyMasterDataModule .


###  https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntologyProductHierarchy
sd:SalesDistributionOntologyProductHierarchy rdf:type owl:Class ;
                                             rdfs:comment "A hierarchical structure organizing products into divisions, categories, brands and SKUs."@en ;
                                             rdfs:isDefinedBy <https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntology> ;
                                             rdfs:label "Product Hierarchy"@en ;
                                             sd:SalesDistributionOntologyinModule sd:SalesDistributionOntologyMasterDataModule .


###  https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntologyProductPack
sd:SalesDistributionOntologyProductPack rdf:type owl:Class ;
                                        rdfs:comment "A packaging configuration of a product, such as a pouch, carton or case."@en ;
                                        rdfs:isDefinedBy <https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntology> ;
                                        rdfs:label "Product Pack"@en ;
                                        sd:SalesDistributionOntologyinModule sd:SalesDistributionOntologyMasterDataModule .


###  https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntologyProductVariant
sd:SalesDistributionOntologyProductVariant rdf:type owl:Class ;
                                           rdfs:subClassOf sd:SalesDistributionOntologyProduct ;
                                           rdfs:comment "A variation of a product, such as flavour, size or formulation."@en ;
                                           rdfs:isDefinedBy <https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntology> ;
                                           rdfs:label "Product Variant"@en ;
                                           sd:SalesDistributionOntologyinModule sd:SalesDistributionOntologyMasterDataModule .


###  https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntologyPromotedOrder
sd:SalesDistributionOntologyPromotedOrder rdf:type owl:Class ;
                                          owl:equivalentClass [ owl:intersectionOf ( sd:SalesDistributionOntologySalesOrder
                                                                                     [ rdf:type owl:Restriction ;
                                                                                       owl:onProperty sd:SalesDistributionOntologyhasPromotion ;
                                                                                       owl:someValuesFrom sd:SalesDistributionOntologyTradePromotion
                                                                                     ]
                                                                                   ) ;
                                                                rdf:type owl:Class
                                                              ] ;
                                          rdfs:comment "A sales order to which at least one trade promotion has been applied."@en ;
                                          rdfs:isDefinedBy <https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntology> ;
                                          rdfs:label "Promoted Order"@en .


###  https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntologyPromotionEligibility
sd:SalesDistributionOntologyPromotionEligibility rdf:type owl:Class ;
                                                 rdfs:comment "Criteria determining which customers or outlets qualify for a promotion."@en ;
                                                 rdfs:isDefinedBy <https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntology> ;
                                                 rdfs:label "Promotion Eligibility"@en ;
                                                 sd:SalesDistributionOntologyinModule sd:SalesDistributionOntologyTradePromotionModule .


###  https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntologyPromotionPeriod
sd:SalesDistributionOntologyPromotionPeriod rdf:type owl:Class ;
                                            rdfs:comment "The validity period of a promotion."@en ;
                                            rdfs:isDefinedBy <https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntology> ;
                                            rdfs:label "Promotion Period"@en ;
                                            sd:SalesDistributionOntologyinModule sd:SalesDistributionOntologyTradePromotionModule .


###  https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntologyPromotionScheme
sd:SalesDistributionOntologyPromotionScheme rdf:type owl:Class ;
                                            rdfs:subClassOf sd:SalesDistributionOntologyTradePromotion ;
                                            rdfs:comment "A trade promotion scheme with defined eligibility, benefit and period, such as buy-X-get-Y or slab discounts."@en ;
                                            rdfs:isDefinedBy <https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntology> ;
                                            rdfs:label "Promotion Scheme"@en ;
                                            skos:altLabel "Scheme"@en ,
                                                          "Trade Scheme"@en ;
                                            sd:SalesDistributionOntologyinModule sd:SalesDistributionOntologyTradePromotionModule .


###  https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntologyProofOfDelivery
sd:SalesDistributionOntologyProofOfDelivery rdf:type owl:Class ;
                                            rdfs:comment "Evidence that goods were received by the consignee, such as a signature or photo."@en ;
                                            rdfs:isDefinedBy <https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntology> ;
                                            rdfs:label "Proof Of Delivery"@en ;
                                            skos:altLabel "POD"@en ;
                                            sd:SalesDistributionOntologyinModule sd:SalesDistributionOntologyFulfillmentModule .


###  https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntologyPurchaseOrder
sd:SalesDistributionOntologyPurchaseOrder rdf:type owl:Class ;
                                          rdfs:comment "A buyer-issued document authorizing a purchase, referenced by the seller's sales order."@en ;
                                          rdfs:isDefinedBy <https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntology> ;
                                          rdfs:label "Purchase Order"@en ;
                                          skos:altLabel "Customer PO"@en ,
                                                        "PO"@en ;
                                          sd:SalesDistributionOntologyinModule sd:SalesDistributionOntologyOrderManagementModule .


###  https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntologyQuotation
sd:SalesDistributionOntologyQuotation rdf:type owl:Class ;
                                      rdfs:comment "A priced offer issued to a customer before an order is placed."@en ;
                                      rdfs:isDefinedBy <https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntology> ;
                                      rdfs:label "Quotation"@en ;
                                      sd:SalesDistributionOntologyerpMapping "SAP SD: Quotation (document category B)" ;
                                      sd:SalesDistributionOntologyinModule sd:SalesDistributionOntologyOrderManagementModule .


###  https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntologyRebateClaim
sd:SalesDistributionOntologyRebateClaim rdf:type owl:Class ;
                                        rdfs:subClassOf sd:SalesDistributionOntologyClaim ;
                                        rdfs:comment "A claim for a rebate earned under a rebate program."@en ;
                                        rdfs:isDefinedBy <https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntology> ;
                                        rdfs:label "Rebate Claim"@en ;
                                        sd:SalesDistributionOntologyinModule sd:SalesDistributionOntologyTradePromotionModule .


###  https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntologyRebateProgram
sd:SalesDistributionOntologyRebateProgram rdf:type owl:Class ;
                                          rdfs:comment "A program that gives retrospective payments to partners on achieving volume or growth conditions."@en ;
                                          rdfs:isDefinedBy <https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntology> ;
                                          rdfs:label "Rebate Program"@en ;
                                          sd:SalesDistributionOntologyinModule sd:SalesDistributionOntologyTradePromotionModule .


###  https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntologyRegion
sd:SalesDistributionOntologyRegion rdf:type owl:Class ;
                                   rdfs:subClassOf sd:SalesDistributionOntologyGeography ;
                                   rdfs:comment "A large geographic grouping of zones, typically headed by a regional sales manager."@en ;
                                   rdfs:isDefinedBy <https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntology> ;
                                   rdfs:label "Region"@en ;
                                   sd:SalesDistributionOntologyinModule sd:SalesDistributionOntologyRouteToMarketModule .


###  https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntologyReorderPoint
sd:SalesDistributionOntologyReorderPoint rdf:type owl:Class ;
                                         rdfs:comment "The stock level at which replenishment is triggered."@en ;
                                         rdfs:isDefinedBy <https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntology> ;
                                         rdfs:label "Reorder Point"@en ;
                                         skos:altLabel "ROP"@en ;
                                         sd:SalesDistributionOntologyinModule sd:SalesDistributionOntologyInventoryManagementModule .


###  https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntologyReplacementOrder
sd:SalesDistributionOntologyReplacementOrder rdf:type owl:Class ;
                                             rdfs:subClassOf sd:SalesDistributionOntologySalesOrder ;
                                             rdfs:comment "A sales order created to replace goods that were returned or damaged."@en ;
                                             rdfs:isDefinedBy <https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntology> ;
                                             rdfs:label "Replacement Order"@en ;
                                             sd:SalesDistributionOntologyinModule sd:SalesDistributionOntologyReturnsModule .


###  https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntologyReservedInventory
sd:SalesDistributionOntologyReservedInventory rdf:type owl:Class ;
                                              rdfs:subClassOf sd:SalesDistributionOntologyInventoryPosition ;
                                              rdfs:comment "The quantity earmarked for orders but not yet dispatched."@en ;
                                              rdfs:isDefinedBy <https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntology> ;
                                              rdfs:label "Reserved Inventory"@en ;
                                              sd:SalesDistributionOntologyinModule sd:SalesDistributionOntologyInventoryManagementModule .


###  https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntologyRetailPrice
sd:SalesDistributionOntologyRetailPrice rdf:type owl:Class ;
                                        rdfs:subClassOf sd:SalesDistributionOntologyPrice ;
                                        rdfs:comment "The price at which a distributor sells to a retailer."@en ;
                                        rdfs:isDefinedBy <https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntology> ;
                                        rdfs:label "Retail Price"@en ;
                                        sd:SalesDistributionOntologyinModule sd:SalesDistributionOntologyPricingModule .


###  https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntologyRetailer
sd:SalesDistributionOntologyRetailer rdf:type owl:Class ;
                                     rdfs:subClassOf sd:SalesDistributionOntologyChannelPartner ;
                                     rdfs:comment "A channel partner that sells products to end consumers."@en ;
                                     rdfs:isDefinedBy <https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntology> ;
                                     rdfs:label "Retailer"@en ;
                                     sd:SalesDistributionOntologyinModule sd:SalesDistributionOntologyRouteToMarketModule .


###  https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntologyRetailerOrder
sd:SalesDistributionOntologyRetailerOrder rdf:type owl:Class ;
                                          rdfs:subClassOf sd:SalesDistributionOntologySecondarySalesOrder ;
                                          rdfs:comment "A secondary sales order placed by a retailer on a distributor."@en ;
                                          rdfs:isDefinedBy <https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntology> ;
                                          rdfs:label "Retailer Order"@en ;
                                          sd:SalesDistributionOntologyinModule sd:SalesDistributionOntologyOrderManagementModule .


###  https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntologyReturnAuthorization
sd:SalesDistributionOntologyReturnAuthorization rdf:type owl:Class ;
                                                rdfs:subClassOf [ rdf:type owl:Restriction ;
                                                                  owl:onProperty sd:SalesDistributionOntologyauthorizesReturn ;
                                                                  owl:someValuesFrom sd:SalesDistributionOntologyReturnOrder
                                                                ] ;
                                                rdfs:comment "An approval permitting a customer to return goods."@en ;
                                                rdfs:isDefinedBy <https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntology> ;
                                                rdfs:label "Return Authorization"@en ;
                                                sd:SalesDistributionOntologyinModule sd:SalesDistributionOntologyReturnsModule .


###  https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntologyReturnOrder
sd:SalesDistributionOntologyReturnOrder rdf:type owl:Class ;
                                        rdfs:subClassOf [ rdf:type owl:Restriction ;
                                                          owl:onProperty sd:SalesDistributionOntologyhasReturnReason ;
                                                          owl:someValuesFrom sd:SalesDistributionOntologyReturnReason
                                                        ] ,
                                                        [ rdf:type owl:Restriction ;
                                                          owl:onProperty sd:SalesDistributionOntologyreturnsAgainst ;
                                                          owl:someValuesFrom sd:SalesDistributionOntologySalesOrder
                                                        ] ,
                                                        [ rdf:type owl:Restriction ;
                                                          owl:onProperty sd:SalesDistributionOntologyhasReturnLine ;
                                                          owl:minCardinality "1"^^xsd:nonNegativeInteger
                                                        ] ;
                                        rdfs:comment "A document initiating the return of goods against a sales order."@en ;
                                        rdfs:isDefinedBy <https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntology> ;
                                        rdfs:label "Return Order"@en ;
                                        sd:SalesDistributionOntologyerpMapping "SAP SD: Returns (document category H)" ;
                                        sd:SalesDistributionOntologyinModule sd:SalesDistributionOntologyReturnsModule .


###  https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntologyReturnOrderLine
sd:SalesDistributionOntologyReturnOrderLine rdf:type owl:Class ;
                                            rdfs:subClassOf [ rdf:type owl:Restriction ;
                                                              owl:onProperty sd:SalesDistributionOntologyreturnsOrderLine ;
                                                              owl:someValuesFrom sd:SalesDistributionOntologySalesOrderLine
                                                            ] ;
                                            rdfs:comment "A line of a return order specifying product, quantity and condition."@en ;
                                            rdfs:isDefinedBy <https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntology> ;
                                            rdfs:label "Return Order Line"@en ;
                                            sd:SalesDistributionOntologyinModule sd:SalesDistributionOntologyReturnsModule .


###  https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntologyReturnReason
sd:SalesDistributionOntologyReturnReason rdf:type owl:Class ;
                                         rdfs:comment "A coded reason for returning goods."@en ;
                                         rdfs:isDefinedBy <https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntology> ;
                                         rdfs:label "Return Reason"@en ;
                                         sd:SalesDistributionOntologyinModule sd:SalesDistributionOntologyReturnsModule .


###  https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntologyReturnReceipt
sd:SalesDistributionOntologyReturnReceipt rdf:type owl:Class ;
                                          rdfs:subClassOf sd:SalesDistributionOntologyGoodsReceipt ,
                                                          [ rdf:type owl:Restriction ;
                                                            owl:onProperty sd:SalesDistributionOntologyreceivesReturn ;
                                                            owl:someValuesFrom sd:SalesDistributionOntologyReturnOrder
                                                          ] ;
                                          rdfs:comment "The receipt of returned goods at a location."@en ;
                                          rdfs:isDefinedBy <https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntology> ;
                                          rdfs:label "Return Receipt"@en ;
                                          sd:SalesDistributionOntologyinModule sd:SalesDistributionOntologyReturnsModule .


