sd:SalesDistributionOntologyShipmentLine rdf:type owl:Class ;
                                         rdfs:subClassOf [ rdf:type owl:Restriction ;
                                                           owl:onProperty sd:SalesDistributionOntologyshipsProduct ;
                                                           owl:someValuesFrom sd:SalesDistributionOntologyProduct
                                                         ] ;
                                         rdfs:comment "A line of a shipment specifying product, quantity and batch."@en ;
                                         rdfs:isDefinedBy <https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntology> ;
