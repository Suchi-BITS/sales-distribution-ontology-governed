                                      rdfs:range xsd:decimal ,
                                                 sd:SalesDistributionOntologyNonNegativeDecimal ;
                                      rdfs:comment "Price per unit of measure before discount and tax."@en ;
                                      rdfs:isDefinedBy <https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntology> ;
                                      rdfs:label "unit price"@en .


###  https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntologyupdatedAt
sd:SalesDistributionOntologyupdatedAt rdf:type owl:DatatypeProperty ;
                                      rdfs:range xsd:dateTime ;
                                      rdfs:comment "Timestamp at which the record was last updated."@en ;
                                      rdfs:isDefinedBy <https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntology> ;
                                      rdfs:label "updated at"@en .


###  https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntologyutilizationPercentage
sd:SalesDistributionOntologyutilizationPercentage rdf:type owl:DatatypeProperty ;
                                                  rdfs:domain sd:SalesDistributionOntologyCreditExposure ;
                                                  rdfs:range sd:SalesDistributionOntologyPercentageValue ;
                                                  rdfs:comment "Percentage of the credit limit utilized."@en ;
                                                  rdfs:isDefinedBy <https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntology> ;
                                                  rdfs:label "utilization percentage"@en .


###  https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntologyvarianceQuantity
sd:SalesDistributionOntologyvarianceQuantity rdf:type owl:DatatypeProperty ;
                                             rdfs:domain [ rdf:type owl:Class ;
                                                           owl:unionOf ( sd:SalesDistributionOntologyCycleCount
                                                                         sd:SalesDistributionOntologyStockTake
                                                                       )
                                                         ] ;
                                             rdfs:range xsd:decimal ;
                                             rdfs:comment "Counted minus system quantity."@en ;
                                             rdfs:isDefinedBy <https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntology> ;
                                             rdfs:label "variance quantity"@en .


###  https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntologyvisitDateTime
sd:SalesDistributionOntologyvisitDateTime rdf:type owl:DatatypeProperty ,
                                                   owl:FunctionalProperty ;
                                          rdfs:domain sd:SalesDistributionOntologySalesVisit ;
                                          rdfs:range xsd:dateTime ;
                                          rdfs:comment "Date and time of a sales visit."@en ;
                                          rdfs:isDefinedBy <https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntology> ;
                                          rdfs:label "visit date time"@en .


###  https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntologyvisitOutcome
sd:SalesDistributionOntologyvisitOutcome rdf:type owl:DatatypeProperty ;
                                         rdfs:domain sd:SalesDistributionOntologySalesVisit ;
                                         rdfs:range xsd:string ;
                                         rdfs:comment "Result of a sales visit."@en ;
                                         rdfs:isDefinedBy <https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntology> ;
                                         rdfs:label "visit outcome"@en .


