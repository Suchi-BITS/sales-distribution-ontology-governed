                                             skos:altLabel "Returns Logistics"@en ;
                                             sd:SalesDistributionOntologyinModule sd:SalesDistributionOntologyReturnsModule .


###  https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntologyRole
sd:SalesDistributionOntologyRole rdf:type owl:Class ;
                                 rdfs:comment "A set of responsibilities assigned to users."@en ;
                                 rdfs:isDefinedBy <https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntology> ;
                                 rdfs:label "Role"@en ;
                                 sd:SalesDistributionOntologyinModule sd:SalesDistributionOntologySecurityAndAuditModule .


###  https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntologyRoute
sd:SalesDistributionOntologyRoute rdf:type owl:Class ;
                                  rdfs:comment "A planned path linking outlets or delivery points for sales coverage or delivery."@en ;
                                  rdfs:isDefinedBy <https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntology> ;
                                  rdfs:label "Route"@en ;
                                  sd:SalesDistributionOntologyinModule sd:SalesDistributionOntologyRouteToMarketModule .


###  https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntologyRoutePlan
sd:SalesDistributionOntologyRoutePlan rdf:type owl:Class ;
                                      rdfs:comment "A plan sequencing routes, stops and vehicles for deliveries."@en ;
                                      rdfs:isDefinedBy <https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntology> ;
                                      rdfs:label "Route Plan"@en ;
                                      sd:SalesDistributionOntologyinModule sd:SalesDistributionOntologyFulfillmentModule .


###  https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntologyRouteToMarketModule
sd:SalesDistributionOntologyRouteToMarketModule rdf:type owl:Class ;
                                                rdfs:subClassOf sd:SalesDistributionOntologySalesDistributionManagement ;
                                                rdfs:comment "Capability for channel design, territories, beats and outlet coverage."@en ;
                                                rdfs:isDefinedBy <https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntology> ;
                                                rdfs:label "Route To Market Module"@en .


###  https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntologySCMSystem
sd:SalesDistributionOntologySCMSystem rdf:type owl:Class ;
                                      rdfs:subClassOf sd:SalesDistributionOntologyExternalSystem ;
                                      rdfs:comment "A supply chain management or warehouse management system."@en ;
                                      rdfs:isDefinedBy <https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntology> ;
                                      rdfs:label "SCM system"@en ;
                                      sd:SalesDistributionOntologyinModule sd:SalesDistributionOntologyIntegrationModule .


###  https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntologySKU
sd:SalesDistributionOntologySKU rdf:type owl:Class ;
                                rdfs:subClassOf sd:SalesDistributionOntologyProduct ,
                                                [ rdf:type owl:Restriction ;
                                                  owl:onProperty sd:SalesDistributionOntologybelongsToCategory ;
                                                  owl:someValuesFrom sd:SalesDistributionOntologyProductCategory
                                                ] ,
                                                [ rdf:type owl:Restriction ;
                                                  owl:onProperty sd:SalesDistributionOntologyhasBrand ;
                                                  owl:someValuesFrom sd:SalesDistributionOntologyProductBrand
                                                ] ,
                                                [ rdf:type owl:Restriction ;
                                                  owl:onProperty sd:SalesDistributionOntologyusesUOM ;
                                                  owl:someValuesFrom sd:SalesDistributionOntologyUnitOfMeasure
                                                ] ;
                                owl:hasKey ( sd:SalesDistributionOntologycode
                                           ) ;
                                rdfs:comment "A stock keeping unit: the smallest uniquely identifiable and sellable version of a product."@en ;
                                rdfs:isDefinedBy <https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntology> ;
                                rdfs:label "SKU"@en ;
                                skos:altLabel "Article"@en ,
                                              "Stock Keeping Unit"@en ;
                                sd:SalesDistributionOntologyinModule sd:SalesDistributionOntologyMasterDataModule .


###  https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntologySafetyStock
sd:SalesDistributionOntologySafetyStock rdf:type owl:Class ;
                                        rdfs:comment "The buffer quantity held to protect against demand or supply variability."@en ;
                                        rdfs:isDefinedBy <https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntology> ;
                                        rdfs:label "Safety Stock"@en ;
                                        sd:SalesDistributionOntologyinModule sd:SalesDistributionOntologyInventoryManagementModule .


###  https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntologySalesActual
sd:SalesDistributionOntologySalesActual rdf:type owl:Class ;
                                        rdfs:comment "The actual sales result recorded for a period."@en ;
                                        rdfs:isDefinedBy <https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntology> ;
                                        rdfs:label "Sales Actual"@en ;
                                        sd:SalesDistributionOntologyinModule sd:SalesDistributionOntologyTargetAndForecastModule .


###  https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntologySalesDistributionManagement
sd:SalesDistributionOntologySalesDistributionManagement rdf:type owl:Class ;
                                                        rdfs:comment "Application/domain capability encompassing channel management, sales execution, order management, pricing, trade promotions, distributor operations, inventory visibility, fulfillment, collections, returns, field force and analytics."@en ,
                                                                     "Recommended module decomposition: master data; route-to-market/channel; distributor management; primary sales; secondary sales; order management; pricing; promotions; inventory; fulfillment; invoicing; collections; returns; field force; targets/forecasting; analytics; integrations; security/audit."@en ;
                                                        rdfs:isDefinedBy <https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntology> ;
                                                        rdfs:label "Sales Distribution Management"@en .


###  https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntologySalesEmployee
sd:SalesDistributionOntologySalesEmployee rdf:type owl:Class ;
                                          rdfs:subClassOf sd:SalesDistributionOntologyEmployee ;
                                          rdfs:comment "An employee whose role directly involves selling, servicing or managing sales activity."@en ;
                                          rdfs:isDefinedBy <https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntology> ;
                                          rdfs:label "Sales Employee"@en ;
                                          sd:SalesDistributionOntologyinModule sd:SalesDistributionOntologyFieldSalesModule .


###  https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntologySalesForecast
sd:SalesDistributionOntologySalesForecast rdf:type owl:Class ;
                                          rdfs:subClassOf sd:SalesDistributionOntologyForecast ;
                                          rdfs:comment "A forecast of future sales volume or value."@en ;
                                          rdfs:isDefinedBy <https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntology> ;
                                          rdfs:label "Sales Forecast"@en ;
                                          sd:SalesDistributionOntologyinModule sd:SalesDistributionOntologyTargetAndForecastModule .


###  https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntologySalesKPI
sd:SalesDistributionOntologySalesKPI rdf:type owl:Class ;
                                     rdfs:comment "A measure of sales performance."@en ;
                                     rdfs:isDefinedBy <https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntology> ;
                                     rdfs:label "Sales KPI"@en ;
                                     sd:SalesDistributionOntologyinModule sd:SalesDistributionOntologyAnalyticsModule .


###  https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntologySalesManager
sd:SalesDistributionOntologySalesManager rdf:type owl:Class ;
                                         rdfs:subClassOf sd:SalesDistributionOntologySalesEmployee ;
                                         rdfs:comment "A sales employee who manages sales representatives, targets and performance for a geography or channel."@en ;
                                         rdfs:isDefinedBy <https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntology> ;
                                         rdfs:label "Sales Manager"@en ;
                                         skos:altLabel "Regional Sales Manager"@en ;
                                         sd:SalesDistributionOntologyinModule sd:SalesDistributionOntologyFieldSalesModule .


###  https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntologySalesOrder
sd:SalesDistributionOntologySalesOrder rdf:type owl:Class ;
                                       rdfs:subClassOf [ rdf:type owl:Restriction ;
                                                         owl:onProperty sd:SalesDistributionOntologyhasOrderStatus ;
                                                         owl:someValuesFrom sd:SalesDistributionOntologyOrderStatus
                                                       ] ,
                                                       [ rdf:type owl:Restriction ;
                                                         owl:onProperty sd:SalesDistributionOntologyplacedBy ;
                                                         owl:someValuesFrom sd:SalesDistributionOntologyCustomer
                                                       ] ,
                                                       [ rdf:type owl:Restriction ;
                                                         owl:onProperty sd:SalesDistributionOntologyhasOrderLine ;
                                                         owl:minCardinality "1"^^xsd:nonNegativeInteger
                                                       ] ,
                                                       [ rdf:type owl:Restriction ;
                                                         owl:onProperty sd:SalesDistributionOntologyorderDate ;
                                                         owl:someValuesFrom xsd:dateTime
                                                       ] ;
                                       owl:hasKey ( sd:SalesDistributionOntologyidentifier
                                                  ) ;
                                       rdfs:comment "A customer's commitment to buy specified products at agreed prices and terms."@en ;
                                       rdfs:isDefinedBy <https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntology> ;
                                       rdfs:label "Sales Order"@en ;
                                       skos:altLabel "Customer Order"@en ,
                                                     "SO"@en ;
                                       sd:SalesDistributionOntologyerpMapping "SAP SD: Sales document header (VBAK)" ;
                                       sd:SalesDistributionOntologyinModule sd:SalesDistributionOntologyOrderManagementModule .


###  https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntologySalesOrderLine
sd:SalesDistributionOntologySalesOrderLine rdf:type owl:Class ;
                                           rdfs:subClassOf [ rdf:type owl:Restriction ;
                                                             owl:onProperty sd:SalesDistributionOntologyquantityUnit ;
                                                             owl:someValuesFrom sd:SalesDistributionOntologyUnitOfMeasure
                                                           ] ,
                                                           [ rdf:type owl:Restriction ;
                                                             owl:onProperty sd:SalesDistributionOntologyhasProduct ;
                                                             owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                             owl:onClass sd:SalesDistributionOntologyProduct
                                                           ] ,
                                                           [ rdf:type owl:Restriction ;
                                                             owl:onProperty sd:SalesDistributionOntologyreferencesOrder ;
                                                             owl:cardinality "1"^^xsd:nonNegativeInteger
                                                           ] ,
                                                           [ rdf:type owl:Restriction ;
                                                             owl:onProperty sd:SalesDistributionOntologyquantity ;
                                                             owl:someValuesFrom xsd:decimal
                                                           ] ;
                                           rdfs:comment "A line of a sales order specifying product, quantity, price and amounts."@en ;
                                           rdfs:isDefinedBy <https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntology> ;
                                           rdfs:label "Sales Order Line"@en ;
                                           sd:SalesDistributionOntologyerpMapping "SAP SD: Sales document item (VBAP)" ;
                                           sd:SalesDistributionOntologyinModule sd:SalesDistributionOntologyOrderManagementModule .


###  https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntologySalesOrganization
sd:SalesDistributionOntologySalesOrganization rdf:type owl:Class ;
                                              rdfs:subClassOf sd:SalesDistributionOntologyBusinessOrganization ;
                                              rdfs:comment "An organizational unit of the brand owner that is responsible for selling products and services in a defined market or channel."@en ;
                                              rdfs:isDefinedBy <https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntology> ;
                                              rdfs:label "Sales Organization"@en ;
                                              sd:SalesDistributionOntologyerpMapping "SAP SD: Sales Organization (VKORG)" ;
                                              sd:SalesDistributionOntologyinModule sd:SalesDistributionOntologyRouteToMarketModule .


###  https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntologySalesProcess
sd:SalesDistributionOntologySalesProcess rdf:type owl:Class ;
                                         rdfs:comment "A stage or flow in the sales cycle, such as lead-to-quote or order-to-cash."@en ;
                                         rdfs:isDefinedBy <https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntology> ;
                                         rdfs:label "Sales Process"@en ;
                                         sd:SalesDistributionOntologyinModule sd:SalesDistributionOntologyOrderManagementModule .


###  https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntologySalesRepresentative
sd:SalesDistributionOntologySalesRepresentative rdf:type owl:Class ;
                                                rdfs:subClassOf sd:SalesDistributionOntologySalesEmployee ;
                                                rdfs:comment "A sales employee who sells to and services customers."@en ;
                                                rdfs:isDefinedBy <https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntology> ;
                                                rdfs:label "Sales Representative"@en ;
                                                sd:SalesDistributionOntologyinModule sd:SalesDistributionOntologyFieldSalesModule .


###  https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntologySalesTarget
sd:SalesDistributionOntologySalesTarget rdf:type owl:Class ;
                                        rdfs:subClassOf [ rdf:type owl:Restriction ;
                                                          owl:onProperty sd:SalesDistributionOntologytargetValue ;
                                                          owl:someValuesFrom xsd:decimal
                                                        ] ;
                                        rdfs:comment "A goal for sales performance for an employee, territory, partner or period."@en ;
                                        rdfs:isDefinedBy <https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntology> ;
                                        rdfs:label "Sales Target"@en ;
                                        sd:SalesDistributionOntologyinModule sd:SalesDistributionOntologyTargetAndForecastModule .


###  https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntologySalesVisit
sd:SalesDistributionOntologySalesVisit rdf:type owl:Class ;
                                       rdfs:subClassOf [ rdf:type owl:Restriction ;
                                                         owl:onProperty sd:SalesDistributionOntologyvisits ;
                                                         owl:someValuesFrom sd:SalesDistributionOntologyOutlet
                                                       ] ,
