###  https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntologyAccountsReceivable
sd:SalesDistributionOntologyAccountsReceivable rdf:type owl:Class ;
                                               rdfs:comment "A receivable representing money owed by a customer."@en ;
                                               rdfs:isDefinedBy <https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntology> ;
                                               rdfs:label "Accounts Receivable"@en ;
                                               skos:altLabel "AR"@en ;
                                               sd:SalesDistributionOntologyinModule sd:SalesDistributionOntologyCollectionsModule .


###  https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntologyActiveDistributor
sd:SalesDistributionOntologyActiveDistributor rdf:type owl:Class ;
                                              owl:equivalentClass [ owl:intersectionOf ( sd:SalesDistributionOntologyDistributor
                                                                                         [ rdf:type owl:Restriction ;
                                                                                           owl:onProperty sd:SalesDistributionOntologyisActive ;
                                                                                           owl:hasValue "true"^^xsd:boolean
                                                                                         ]
                                                                                       ) ;
                                                                    rdf:type owl:Class
                                                                  ] ;
                                              rdfs:comment "A distributor that is currently active in the network."@en ;
                                              rdfs:isDefinedBy <https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntology> ;
                                              rdfs:label "Active Distributor"@en .


###  https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntologyAllocationRule
sd:SalesDistributionOntologyAllocationRule rdf:type owl:Class ;
                                           rdfs:subClassOf sd:SalesDistributionOntologyBusinessRule ;
                                           rdfs:comment "A rule determining how scarce stock is allocated to demand."@en ;
                                           rdfs:isDefinedBy <https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntology> ;
                                           rdfs:label "Allocation Rule"@en ;
                                           sd:SalesDistributionOntologyinModule sd:SalesDistributionOntologyOrderManagementModule .


###  https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntologyAnalyticsModule
sd:SalesDistributionOntologyAnalyticsModule rdf:type owl:Class ;
                                            rdfs:subClassOf sd:SalesDistributionOntologySalesDistributionManagement ;
                                            rdfs:comment "Capability for KPIs, dashboards and analytics."@en ;
                                            rdfs:isDefinedBy <https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntology> ;
                                            rdfs:label "Analytics Module"@en .


###  https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntologyApprovalRule
sd:SalesDistributionOntologyApprovalRule rdf:type owl:Class ;
                                         rdfs:subClassOf sd:SalesDistributionOntologyBusinessRule ;
                                         rdfs:comment "A rule specifying when an approval is required and by whom."@en ;
                                         rdfs:isDefinedBy <https://abhigya.ai/ontology/sales-distribution#SalesDistributionOntology> ;
                                         rdfs:label "Approval Rule"@en ;
                                         sd:SalesDistributionOntologyinModule sd:SalesDistributionOntologyOrderManagementModule .


