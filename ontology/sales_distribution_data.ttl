@prefix sd: <https://abhigya.ai/ontology/sales-distribution#> .
@prefix sdi: <https://abhigya.ai/ontology/sales-distribution/data#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

#################################################################
# Sales & Distribution ABox / sample data
#
# All ontology classes and properties use the canonical IRIs found
# in sales_distribution_ontology.ttl:
# sd:SalesDistributionOntology{TermName}
#
# Source-semantic limitations are preserved; no unsupported
# mappings or transaction-level lineage are invented.
#################################################################

############################
# Master / partner entities
############################

sdi:Distributor_ABC
    a sd:SalesDistributionOntologyDistributor,
      sd:SalesDistributionOntologyBusinessOrganization ;
    sd:SalesDistributionOntologyidentifier "123" ;
    sd:SalesDistributionOntologyname "ABC" .

sdi:ResaleCustomer_DEF
    a sd:SalesDistributionOntologyRetailer ;
    sd:SalesDistributionOntologyidentifier "D123" ;
    sd:SalesDistributionOntologyname "DEF" .

sdi:FinalCustomer_GHI
    a sd:SalesDistributionOntologyCustomer ;
    sd:SalesDistributionOntologyidentifier "G123" ;
    sd:SalesDistributionOntologyname "GHI" .

sdi:Product_P123
    a sd:SalesDistributionOntologyProduct ;
    sd:SalesDistributionOntologyidentifier "P123" ;
    sd:SalesDistributionOntologyname "P123" .

############################
# UC-01: Point of Purchase
############################

sdi:PrimarySale_ABC_P123_202609
    a sd:SalesDistributionOntologyPrimarySalesTransaction ;
    sd:SalesDistributionOntologyidentifier "POP-ABC-P123-202609" ;
    sd:SalesDistributionOntologyplacedBy sdi:Distributor_ABC ;
    sd:SalesDistributionOntologyquantity "500"^^xsd:decimal ;
    sd:SalesDistributionOntologynetAmount "12000"^^xsd:decimal .

############################
# UC-02: Point of Sale
############################

sdi:SecondarySale_DEF_GHI_P123_202609
    a sd:SalesDistributionOntologySecondarySalesTransaction ;
    sd:SalesDistributionOntologyidentifier "POS-ABC-DEF-GHI-P123-202609" ;
    sd:SalesDistributionOntologyplacedBy sdi:ResaleCustomer_DEF ;
    sd:SalesDistributionOntologyquantity "120"^^xsd:decimal ;
    sd:SalesDistributionOntologynetAmount "20000"^^xsd:decimal .

sdi:Distributor_ABC
    sd:SalesDistributionOntologysellsTo sdi:ResaleCustomer_DEF .

############################
# UC-03: Partner Inventory
############################

sdi:Inventory_ABC_P123_202609
    a sd:SalesDistributionOntologyInventory ;
    sd:SalesDistributionOntologyidentifier "INV-ABC-P123-202609" ;
    sd:SalesDistributionOntologyownedBy sdi:Distributor_ABC ;
    sd:SalesDistributionOntologyholdsProduct sdi:Product_P123 ;
    sd:SalesDistributionOntologystockQuantity "380"^^xsd:decimal .

############################
# UC-04: Partner Project / Opportunity
#
# The source calls this a Project. No ontology class is asserted
# because the current ontology does not define a confirmed Project
# class and Project must not silently be equated with Opportunity.
############################

sdi:Project_PROJ123
    sd:SalesDistributionOntologyidentifier "PROJ123" ;
    sd:SalesDistributionOntologyname "Wash Machine" ;
    sd:SalesDistributionOntologystatus "In-Progress" .

############################
# UC-05: Partner Quote
############################

sdi:Quotation_PROJ123_202609
    a sd:SalesDistributionOntologyQuotation ;
    sd:SalesDistributionOntologyidentifier "QUOTE-PROJ123-202609" ;
    sd:SalesDistributionOntologyname "Wash Machine quote" ;
    sd:SalesDistributionOntologystatus "Approved" ;
    sd:SalesDistributionOntologyquantity "1000000"^^xsd:decimal ;
    sd:SalesDistributionOntologyunitPrice "80"^^xsd:decimal .

# Retained as comments because there is no semantically confirmed
# property for these source fields:
# - special price requested = 40
# - quote type = BC type
# - quote validity = 2026-12-31

############################
# UC-06: Delivery performance
############################

sdi:SalesOrder_PO1234
    a sd:SalesDistributionOntologySalesOrder ;
    sd:SalesDistributionOntologyidentifier "PO1234" ;
    sd:SalesDistributionOntologyhasOrderLine sdi:SalesOrderLine_PO1234_1 ;
    sd:SalesDistributionOntologyhasDeliveryPromise sdi:DeliveryPromise_PO1234 .

sdi:SalesOrderLine_PO1234_1
    a sd:SalesDistributionOntologySalesOrderLine ;
    sd:SalesDistributionOntologyhasProduct sdi:Product_P123 ;
    sd:SalesDistributionOntologyquantity "35000"^^xsd:decimal .

sdi:DeliveryPromise_PO1234
    a sd:SalesDistributionOntologyDeliveryPromise ;
    sd:SalesDistributionOntologyrequestedDeliveryDate "2026-11-11T00:00:00"^^xsd:dateTime ;
    sd:SalesDistributionOntologypromisedDeliveryDate "2027-03-03T00:00:00"^^xsd:dateTime .

############################
# UC-07: Shipment tracking
############################

sdi:Shipment_AWB_123456789
    a sd:SalesDistributionOntologyShipment ;
    sd:SalesDistributionOntologyidentifier "123456789" .

sdi:GoodsIssue_ABC_P123_20261212
    a sd:SalesDistributionOntologyGoodsIssue ;
    sd:SalesDistributionOntologyidentifier "GI-ABC-P123-20261212" ;
    sd:SalesDistributionOntologyactualDeliveryDate "2026-12-12T00:00:00"^^xsd:dateTime .

# Source field is "Actual goods issue date", not actual delivery date.
# actualDeliveryDate is a provisional representation and should not
# be treated as semantically final. Prefer a dedicated goodsIssueDate
# property on GoodsIssue during ontology refinement.
#
# Other limitations:
# - Inventory Quantity maps to stockQuantity, not availableQuantity.
# - Missing inventory rows => zero is a source closed-world rule,
#   not an OWL inference.
# - "Special price requested" is not asserted as approved SpecialPrice.
# - AWB number has no confirmed dedicated ontology property.
# - No exact primary-to-secondary transaction lineage is asserted.
