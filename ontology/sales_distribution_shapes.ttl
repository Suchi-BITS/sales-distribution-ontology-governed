@prefix sd: <https://abhigya.ai/ontology/sales-distribution#> .
@prefix sdi: <https://abhigya.ai/ontology/sales-distribution/data#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

#################################################################
# Sales & Distribution SHACL validation shapes
#
# Canonical ontology IRIs use the local-name pattern:
# sd:SalesDistributionOntology{TermName}
# All ontology terms below are aligned to those canonical IRIs.
#################################################################

sd:SalesDistributionOntologyDistributorShape
    a sh:NodeShape ;
    sh:targetClass sd:SalesDistributionOntologyDistributor ;
    sh:property [
        sh:path sd:SalesDistributionOntologyidentifier ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:message "A Distributor must have exactly one identifier." ;
    ] ;
    sh:property [
        sh:path sd:SalesDistributionOntologyname ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:message "A Distributor must have exactly one name." ;
    ] .

sd:SalesDistributionOntologyProductShape
    a sh:NodeShape ;
    sh:targetClass sd:SalesDistributionOntologyProduct ;
    sh:property [
        sh:path sd:SalesDistributionOntologyidentifier ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:message "A Product must have exactly one identifier." ;
    ] .

sd:SalesDistributionOntologyPrimarySalesTransactionShape
    a sh:NodeShape ;
    sh:targetClass sd:SalesDistributionOntologyPrimarySalesTransaction ;
    sh:property [
        sh:path sd:SalesDistributionOntologyidentifier ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:message "A primary sales transaction must have exactly one identifier." ;
    ] ;
    sh:property [
        sh:path sd:SalesDistributionOntologyquantity ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:decimal ;
        sh:minInclusive 0 ;
        sh:message "A primary sales transaction must have one non-negative quantity." ;
    ] ;
    sh:property [
        sh:path sd:SalesDistributionOntologynetAmount ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:decimal ;
        sh:minInclusive 0 ;
        sh:message "A primary sales transaction must have one non-negative net amount." ;
    ] .

sd:SalesDistributionOntologySecondarySalesTransactionShape
    a sh:NodeShape ;
    sh:targetClass sd:SalesDistributionOntologySecondarySalesTransaction ;
    sh:property [
        sh:path sd:SalesDistributionOntologyidentifier ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:message "A secondary sales transaction must have exactly one identifier." ;
    ] ;
    sh:property [
        sh:path sd:SalesDistributionOntologyquantity ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:decimal ;
        sh:minInclusive 0 ;
        sh:message "A secondary sales transaction must have one non-negative quantity." ;
    ] ;
    sh:property [
        sh:path sd:SalesDistributionOntologynetAmount ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:decimal ;
        sh:minInclusive 0 ;
        sh:message "A secondary sales transaction must have one non-negative net amount." ;
    ] .

sd:SalesDistributionOntologyInventoryShape
    a sh:NodeShape ;
    sh:targetClass sd:SalesDistributionOntologyInventory ;
    sh:property [
        sh:path sd:SalesDistributionOntologyownedBy ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class sd:SalesDistributionOntologyBusinessOrganization ;
        sh:message "Inventory must have exactly one owning business organization." ;
    ] ;
    sh:property [
        sh:path sd:SalesDistributionOntologyholdsProduct ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class sd:SalesDistributionOntologyProduct ;
        sh:message "Inventory must identify exactly one product." ;
    ] ;
    sh:property [
        sh:path sd:SalesDistributionOntologystockQuantity ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:decimal ;
        sh:minInclusive 0 ;
        sh:message "Inventory stock quantity must be one non-negative value." ;
    ] .

sd:SalesDistributionOntologyQuotationShape
    a sh:NodeShape ;
    sh:targetClass sd:SalesDistributionOntologyQuotation ;
    sh:property [
        sh:path sd:SalesDistributionOntologyidentifier ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:message "A quotation must have exactly one identifier." ;
    ] ;
    sh:property [
        sh:path sd:SalesDistributionOntologystatus ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:message "A quotation must have exactly one status." ;
    ] ;
    sh:property [
        sh:path sd:SalesDistributionOntologyquantity ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:decimal ;
        sh:minInclusive 0 ;
        sh:message "A quotation must have one non-negative quote quantity." ;
    ] .

sd:SalesDistributionOntologyDeliveryPromiseShape
    a sh:NodeShape ;
    sh:targetClass sd:SalesDistributionOntologyDeliveryPromise ;
    sh:property [
        sh:path sd:SalesDistributionOntologyrequestedDeliveryDate ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:dateTime ;
        sh:message "A DeliveryPromise must have exactly one requested delivery date." ;
    ] ;
    sh:property [
        sh:path sd:SalesDistributionOntologypromisedDeliveryDate ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:dateTime ;
        sh:message "A DeliveryPromise must have exactly one promised/confirmed delivery date." ;
    ] .

sd:SalesDistributionOntologyShipmentShape
    a sh:NodeShape ;
    sh:targetClass sd:SalesDistributionOntologyShipment ;
    sh:property [
        sh:path sd:SalesDistributionOntologyidentifier ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:message "A shipment must have exactly one identifier." ;
    ] .

sd:SalesDistributionOntologySalesOrderShape
    a sh:NodeShape ;
    sh:targetClass sd:SalesDistributionOntologySalesOrder ;
    sh:property [
        sh:path sd:SalesDistributionOntologyhasOrderLine ;
        sh:minCount 1 ;
        sh:class sd:SalesDistributionOntologySalesOrderLine ;
        sh:message "A SalesOrder must contain at least one SalesOrderLine." ;
    ] .

sd:SalesDistributionOntologySalesOrderLineShape
    a sh:NodeShape ;
    sh:targetClass sd:SalesDistributionOntologySalesOrderLine ;
    sh:property [
        sh:path sd:SalesDistributionOntologyhasProduct ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class sd:SalesDistributionOntologyProduct ;
        sh:message "A SalesOrderLine must reference exactly one Product." ;
    ] .
